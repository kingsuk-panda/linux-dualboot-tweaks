def windows_present():
    """True if a Windows/NTFS/BitLocker partition is visible (best effort)."""
    if not has("lsblk"):
        return False
    r = run(["lsblk", "-rno", "NAME,FSTYPE,LABEL"], check=False)
    for line in (r.stdout or "").splitlines():
        p = line.split()
        if len(p) > 1 and (p[1].lower() in ("ntfs", "bitlocker")
                           or "windows" in " ".join(p[2:]).lower()):
            return True
    return False

# ---------- hibernation ----------
def _uuid_of(dev):
    """UUID of a block device without needing root (via /dev/disk/by-uuid)."""
    try:
        dev_real = os.path.realpath(dev)
        for e in os.listdir("/dev/disk/by-uuid"):
            if os.path.realpath(f"/dev/disk/by-uuid/{e}") == dev_real:
                return e
    except OSError:
        pass
    m = re.search(r'UUID="([^"]+)"', run(["sudo", "-n", "blkid", dev], check=False).stdout or "")
    return m.group(1) if m else None

def hibernation_state():
    """Collect hibernation facts once. Returns (ready, items) where
    items = [(level, message), ...] and level is ok/fail/warn/info."""
    items = []
    st = open("/sys/power/state").read().strip() if os.path.exists("/sys/power/state") else ""
    swaps = []
    if os.path.exists("/proc/swaps"):
        for line in open("/proc/swaps").read().splitlines()[1:]:
            parts = line.split()
            swaps.append((parts[0], int(parts[2])/1024/1024))
    cmdline = open("/proc/cmdline").read()
    fstab = open("/etc/fstab").read()
    has_resume_param = "resume=" in cmdline
    has_mkcpio = os.path.exists("/etc/mkinitcpio.conf") and "resume" in open("/etc/mkinitcpio.conf").read()
    has_initramfs_tools = os.path.exists("/etc/initramfs-tools") and any("RESUME=" in open(os.path.join(r,f), errors="ignore").read() for r,_,files in os.walk("/etc/initramfs-tools") for f in files)
    in_fstab = False
    for dev, _ in swaps:
        u = _uuid_of(dev)
        if dev in fstab or (u and u in fstab):
            in_fstab = True
            break
    mem = os.sysconf("SC_PAGE_SIZE") * os.sysconf("SC_PHYS_PAGES") / 1024**3
    if "disk" in st:
        items.append(("ok", "Kernel supports hibernation (S4 'disk' state). States: " + st))
    else:
        items.append(("fail", f"HIBERNATION IS NOT SUPPORTED. /sys/power/state = '{st or 'empty'}'."))
    if swaps:
        for dev, sz in swaps:
            items.append(("info", f"  swap: {dev} {sz:.0f} GiB"))
        if max(s for _,s in swaps) >= mem*0.9:
            items.append(("ok", f"Swap large enough ({max(s for _,s in swaps):.0f} GiB vs ~{mem:.0f} GiB RAM)."))
        else:
            items.append(("fail", f"Swap too small ({max(s for _,s in swaps):.0f} GiB). Needs ≈ RAM ({mem:.0f} GiB)."))
    else:
        items.append(("fail", "No swap configured. Hibernation impossible without swap."))
    if in_fstab:
        items.append(("ok", "Swap is in /etc/fstab (auto-mounts at boot)."))
    else:
        items.append(("warn", "Swap is NOT in /etc/fstab — resume may fail on cold boot."))
    if has_resume_param:
        items.append(("ok", "Kernel cmdline has resume= param."))
    else:
        items.append(("fail", "Kernel has NO resume= param — hibernated session won't be found."))
    if os.path.exists("/etc/mkinitcpio.conf"):
        items.append(("ok", "mkinitcpio has resume hook.") if has_mkcpio
                     else ("fail", "mkinitcpio is MISSING the resume hook."))
    if os.path.exists("/usr/lib/dracut") or os.path.exists("/usr/bin/dracut"):
        items.append(("info", "  [..] Fedora/RHEL: resume handled by dracut when resume= is set"))
    if os.path.exists("/etc/initramfs-tools"):
        items.append(("ok", "Ubuntu initramfs-tools RESUME= set.") if has_initramfs_tools
                     else ("fail", "Ubuntu initramfs-tools RESUME= missing."))
    if windows_present():
        items.append(("warn", "Windows install detected (dual-boot): turn OFF 'Fast Startup' "
                              "and hibernation inside Windows before testing hibernate, and "
                              "never resume a Linux hibernation after booting Windows — it "
                              "can corrupt your Windows install."))
    ready = bool("disk" in st and swaps and has_resume_param and in_fstab
                 and (has_mkcpio or has_initramfs_tools or os.path.exists("/usr/bin/dracut")))
    return ready, items

def hibernation_ready():
    return hibernation_state()[0]

def hibernate_check():
    print(f"{BOLD}== Hibernation check =={RESET}")
    ready, items = hibernation_state()
    for level, msg in items:
        {"ok": ok_line, "fail": fail_line, "warn": warn_line, "info": print}[level](msg)
    print()
    if ready:
        print(f"{GREEN}{BOLD}>>> HIBERNATION IS ALREADY IMPLEMENTED ON THIS DEVICE — schedule with: systemctl hibernate <<<{RESET}")
    else:
        print(f"{RED}{BOLD}>>> HIBERNATION IS NOT FULLY SET UP — run: sudo tweakctl hibernate enable <<<{RESET}")

def hibernate_enable():
    # swap must be active
    active = []
    if os.path.exists("/proc/swaps"):
        for line in open("/proc/swaps").read().splitlines()[1:]:
            active.append(line.split()[0])
    if not active:
        die("No swap is active — hibernation needs swap at least as big as your "
            "RAM. Create swap first, then re-run this.")
    # Prefer the UUID of an *active* swap device, then any swap partition.
    swap_uuid = None
    for dev in active:
        swap_uuid = _uuid_of(dev)
        if swap_uuid:
            break
    if not swap_uuid:
        out = run(["blkid"], sudo=True, check=False).stdout
        for line in out.splitlines():
            if "TYPE=\"swap\"" in line:
                m = re.search(r'UUID="([^"]+)"', line)
                if m: swap_uuid = m.group(1); break
    if not swap_uuid:
        die("Could not find any swap UUID.")
    d, _ = distro()
    print(f"Detected distro: {d}")
    if d in ("arch",):
        grub_set_param("resume", f"UUID={swap_uuid}")
        grub_set_param("mem_sleep_default", "deep")
        mc = open("/etc/mkinitcpio.conf").read()
        if not re.search(r'HOOKS=\([^)]*\bresume\b', mc):
            run(["sed","-i","s/filesystems/resume filesystems/","/etc/mkinitcpio.conf"], sudo=True)
        run(["grub-mkconfig","-o","/boot/grub/grub.cfg"], sudo=True)
        run(["mkinitcpio","-P"], sudo=True)
    elif d in ("ubuntu","debian","pop","linuxmint"):
        write_root("/etc/initramfs-tools/conf.d/resume", f"RESUME=UUID={swap_uuid}\n")
        grub_set_param("resume", f"UUID={swap_uuid}")
        run(["update-initramfs","-u"], sudo=True)
        if has("update-grub"):
            run(["update-grub"], sudo=True)
        else:
            run(["grub-mkconfig","-o","/boot/grub/grub.cfg"], sudo=True)
    elif d in ("fedora","rhel","centos","rocky","alma","opensuse-leap","opensuse-tumbleweed"):
        run(["grubby","--update-kernel=ALL",f"--args=resume=UUID={swap_uuid}"], sudo=True)
        run(["dracut","--regenerate-all","--force"], sudo=True)
    else:
        print(f"Distro '{d}' is not fully supported for automatic setup. "
              f"Add this to your kernel arguments manually: resume=UUID={swap_uuid}")
    # fstab
    fstab = open("/etc/fstab").read()
    if swap_uuid not in fstab:
        write_root("/etc/fstab", fstab + f"UUID={swap_uuid} none swap defaults 0 0\n")
    ok_line("Hibernation is configured.")
    print("Next steps:  1) reboot   2) test it:  systemctl hibernate")
    if windows_present():
        warn_line("Windows dual-boot: turn OFF Fast Startup in Windows "
                  "(Power Options) before testing — see: tweakctl disclaimer")

# ---------- s3 ----------
def s3_state():
    """Returns (deep_available, deep_active, cmdline_persists)."""
    if not os.path.exists("/sys/power/mem_sleep"):
        return False, False, False
    modes = open("/sys/power/mem_sleep").read()
    return ("deep" in modes, "[deep]" in modes,
            "mem_sleep_default=deep" in open("/proc/cmdline").read())

def s3_active_mode():
    if not os.path.exists("/sys/power/mem_sleep"):
        return "?"
    m = re.search(r"\[(\w+)\]", open("/sys/power/mem_sleep").read())
    return m.group(1) if m else "?"

def s3_check():
    print(f"{BOLD}== S3 sleep check =={RESET}")
    if os.path.exists("/sys/power/mem_sleep"):
        line = open("/sys/power/mem_sleep").read().strip()
        print(f"  mem_sleep modes: {line}")
        if "deep" in line:
            ok_line("S3 (deep) sleep is available on this hardware.")
        else:
            fail_line("S3 (deep) sleep is NOT available on this hardware.")
        if "[deep]" in line:
            ok_line("S3 (deep) is currently the ACTIVE suspend mode.")
        else:
            warn_line("S3 (deep) is NOT the active mode — run: sudo tweakctl s3 set-deep "
                      "(or 'S3 sleep > Deep sleep' in the TUI)")
    else:
        fail_line("/sys/power/mem_sleep is missing — the kernel/ACPI does not "
                  "expose sleep modes on this machine.")
    if "mem_sleep_default=deep" in open("/proc/cmdline").read():
        ok_line("mem_sleep_default=deep persists across reboots.")
    else:
        warn_line("mem_sleep_default=deep is NOT set on the kernel cmdline — "
                  "run: sudo tweakctl s3 set-deep")
    print()
    if os.path.exists("/sys/power/mem_sleep") and "[deep]" in open("/sys/power/mem_sleep").read():
        print(f"{GREEN}{BOLD}>>> S3 DEEP SLEEP IS ACTIVE <<<{RESET}")
    else:
        print(f"{YELLOW}{BOLD}>>> S3 DEEP SLEEP IS NOT ACTIVE <<<{RESET}")

def s3_set(mode="deep"):
    d, _ = distro()
    if d in ("arch","ubuntu","debian","pop","linuxmint"):
        grub_set_param("mem_sleep_default", mode)
        if has("update-grub"):
            run(["update-grub"], sudo=True)
        else:
            run(["grub-mkconfig","-o","/boot/grub/grub.cfg"], sudo=True)
    elif d in ("fedora","rhel","centos","rocky","alma"):
        run(["grubby","--update-kernel=ALL",f"--args=mem_sleep_default={mode}"], sudo=True)
    else:
        die(f"Distro '{d}' is not supported for the S3 toggle "
            f"(needs Arch, Ubuntu/Debian or Fedora/RHEL).")
    # try to apply immediately for the current session too
    run(["bash","-c",f"echo {mode} > /sys/power/mem_sleep"], sudo=True, check=False)
    if os.path.exists("/sys/power/mem_sleep") and f"[{mode}]" in open("/sys/power/mem_sleep").read():
        print(f"Suspend mode '{mode}' is active now and saved across reboots.")
    else:
        print(f"Saved mem_sleep_default={mode} — reboot to apply it.")

# ---------- plymouth ----------
def plymouth_check():
    print(f"{BOLD}== Plymouth check (boot splash) =={RESET}")
    if has('plymouth') or os.path.exists('/usr/share/plymouth'):
        ok_line("Plymouth is installed.")
    else:
        fail_line("Plymouth is NOT installed (boot splash unavailable).")
    cfg = "/etc/plymouth/plymouthd.conf"
    if os.path.exists(cfg):
        m = re.search(r"Theme=(.+)", open(cfg).read())
        print(f"  Current theme: {m.group(1) if m else 'default'}")
    themes_dir = "/usr/share/plymouth/themes"
    if os.path.exists(themes_dir):
        print(f"  Installed themes: {', '.join(os.listdir(themes_dir))}")
    if os.path.exists('/etc/mkinitcpio.conf'):
        if 'plymouth' in open('/etc/mkinitcpio.conf').read():
            ok_line("mkinitcpio has the plymouth hook (splash shows early in boot).")
        else:
            fail_line("mkinitcpio is missing the plymouth hook — the boot splash "
                      "will not show on Arch.")
    if 'splash' in open('/proc/cmdline').read():
        ok_line("Kernel cmdline has 'splash'.")
    else:
        warn_line("Kernel cmdline has no 'splash' — Plymouth will not show at boot.")

def current_plymouth_theme():
    cfg = "/etc/plymouth/plymouthd.conf"
    if os.path.exists(cfg):
        m = re.search(r"Theme=(.+)", open(cfg).read())
        if m and m.group(1).strip():
            return m.group(1).strip()
    if has("plymouth-set-default-theme"):
        r = run(["plymouth-set-default-theme"], check=False)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    return None

def theme_animation_gif(theme):
    """Return a GIF of the theme's animation — bundled, or built from PNG
    frames with ffmpeg (cached in ~/.cache/tweakctl). None if not possible."""
    tdir = f"/usr/share/plymouth/themes/{theme}"
    if not os.path.isdir(tdir):
        return None
    gifs = [f for f in os.listdir(tdir) if f.lower().endswith(".gif")]
    if gifs:
        return os.path.join(tdir, gifs[0])
    frames_dir = tdir
    frames = [f for f in os.listdir(tdir) if re.fullmatch(r"\d+\.png", f)]
    if len(frames) < 2:                       # check one level down (e.g. bootanimation/)
        for sub in sorted(os.listdir(tdir)):
            p = os.path.join(tdir, sub)
            if os.path.isdir(p):
                fs = [f for f in os.listdir(p) if re.fullmatch(r"\d+\.png", f)]
                if len(fs) >= 2:
                    frames_dir, frames = p, fs
                    break
    if len(frames) < 2 or not has("ffmpeg"):
        return None
    nums = sorted(int(f[:-4]) for f in frames)
    if nums != list(range(nums[0], nums[0] + len(nums))):
        return None                            # non-contiguous frames: skip
    cache = os.path.expanduser("~/.cache/tweakctl")
    os.makedirs(cache, exist_ok=True)
    out = os.path.join(cache, f"{theme}-preview.gif")
    newest_src = max(os.path.getmtime(os.path.join(frames_dir, f)) for f in frames)
    if os.path.exists(out) and os.path.getmtime(out) > newest_src:
        return out
    pattern = os.path.join(frames_dir, "%d.png")
    r = run(["ffmpeg","-y","-loglevel","error","-framerate","15",
             "-start_number",str(nums[0]),"-i",pattern,
             "-vf","scale=480:-1:flags=lanczos","-loop","0",out], check=False)
    if r.returncode == 0 and os.path.exists(out):
        return out
    return None

def installed_plymouth_themes():
    d = "/usr/share/plymouth/themes"
    try:
        return sorted(os.listdir(d)) if os.path.isdir(d) else []
    except OSError:
        return []

def plymouth_preview(theme=None, duration=8):
    """Show the real boot splash (best effort), else open the theme animation.
    A non-active theme is set temporarily and restored afterwards."""
    if not has("plymouth") or not has("plymouthd"):
        die("Plymouth is not installed — nothing to preview.")
    current = current_plymouth_theme()
    theme = theme or current or "default"
    if theme != current and not os.path.isdir(f"/usr/share/plymouth/themes/{theme}"):
        die(f"Theme '{theme}' is not installed.")
    print(f"{BOLD}== Plymouth preview: {theme} =={RESET}")
    restore = None
    if theme != current:
        print(f"  (temporarily switching from '{current}' — restored automatically)")
        if run(["plymouth-set-default-theme", theme], sudo=True, check=False).returncode != 0:
            warn_line(f"Could not switch to '{theme}' — previewing the active one instead.")
            theme = current or theme
        else:
            restore = current
    try:
        try:
            tty = os.ttyname(0)
        except OSError:
            tty = None
        already = run(["plymouth","--ping"], sudo=True, check=False).returncode == 0
        daemon = None
        live_ok = False
        try:
            if not already:
                cmd = ["sudo","plymouthd","--mode=boot","--no-daemon",
                       "--pid-file","/run/plymouth-preview.pid"]
                if tty:
                    cmd += ["--tty", tty]
                daemon = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                time.sleep(1.0)
            if run(["plymouth","--show-splash"], sudo=True, check=False).returncode == 0:
                live_ok = True
                print(f"The real boot splash is playing for {duration}s — watch your screen!")
                time.sleep(duration)
        finally:
            run(["plymouth","--quit"], sudo=True, check=False)
            if daemon:
                daemon.terminate()
                try:
                    daemon.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    daemon.kill()
        if live_ok:
            ok_line("Live splash preview finished.")
            return
        warn_line("Live splash could not be shown in this session.")
        gif = theme_animation_gif(theme)
        if gif:
            print(f"Opening the theme's animation instead: {gif}")
            subprocess.Popen(["xdg-open", gif], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).poll()
            ok_line("Animation opened in your image viewer.")
            return
        print("You can still preview it from a free virtual console:")
        print("  sudo plymouthd --mode=boot --tty=/dev/tty2 --pid-file=/run/plymouth.pid")
        print("  sudo plymouth --show-splash      # quit with: sudo plymouth --quit")
    finally:
        if restore:
            run(["plymouth-set-default-theme", restore], sudo=True, check=False)
            print(f"Theme restored to '{restore}'.")

def plymouth_apply(theme):
    if not theme:
        d = "/usr/share/plymouth/themes"
        if not os.path.exists(d): die("Plymouth not installed.")
        theme = input(f"Available: {os.listdir(d)}\nTheme name: ").strip()
    if not os.path.exists(f"/usr/share/plymouth/themes/{theme}"):
        die(f"Theme '{theme}' not installed. Available: {os.listdir('/usr/share/plymouth/themes') if os.path.exists('/usr/share/plymouth/themes') else 'none'}")
    run(["plymouth-set-default-theme", theme], sudo=True, check=False)
    cfg = "/etc/plymouth/plymouthd.conf"
    if os.path.exists(cfg):
        run(["sed","-i",f"s/^Theme=.*/Theme={_sed_repl(theme)}/",cfg], sudo=True)
    d,_ = distro()
    if d=="arch": run(["mkinitcpio","-P"], sudo=True)
    elif d in ("ubuntu","debian"): run(["update-initramfs","-u"], sudo=True)
    elif d in ("fedora","rhel","centos"): run(["dracut","--regenerate-all","--force"], sudo=True)
    ok_line(f"Boot theme set to '{theme}' — reboot to see it at startup.")

# ---------- ctos sound ----------
SOUNDS = {
    "ctos-boot": "~/.local/share/sounds/ctos-boot.ogg",
    "ctos-shutdown": "/usr/share/sounds/ctos/ctos-shutdown.ogg",
}

def current_boot_sound():
    """Path the boot-sound user unit will play, if configured."""
    unit = os.path.expanduser("~/.config/systemd/user/ctos-boot-sound.service")
    try:
        m = re.search(r"(/[\w./+-]+\.(?:ogg|wav|mp3))", open(unit).read())
        return m.group(1) if m else None
    except OSError:
        return None

def sound_choices():
    """[(label, path)] of every playable sound tweakctl can find."""
    cur = current_boot_sound()
    out, seen = [], set()
    def add(label, path):
        if not path or path in seen or not os.path.exists(path):
            return
        seen.add(path)
        out.append((f"{label}  • current" if path == cur else label, path))
    for name, p in SOUNDS.items():
        exp = os.path.expanduser(p)
        add(f"{name:16s} {os.path.basename(exp)}", exp)
    for d in ("~/.local/share/sounds", "/usr/share/sounds/ctos"):
        pth = os.path.expanduser(d)
        if not os.path.isdir(pth):
            continue
        for f in sorted(os.listdir(pth)):
            if f.endswith((".ogg", ".wav", ".mp3")):
                add(os.path.join(pth, f), os.path.join(pth, f))
    return out

def sound_list():
    print(f"{BOLD}== Sounds found =={RESET}")
    print("Bundled ctOS sounds:")
    for name, path in SOUNDS.items():
        expanded = os.path.expanduser(path)
        print(f"  {name:15s} {'present' if os.path.exists(expanded) else 'missing'} ({expanded})")
    for d in ["~/.local/share/sounds", "/usr/share/sounds/ctos"]:
        p = os.path.expanduser(d)
        if os.path.exists(p):
            for f in os.listdir(p):
                if f.endswith(('.ogg','.wav','.mp3')) and f not in [os.path.basename(v) for v in SOUNDS.values()]:
                    print(f"  {f:30s} ({p}/{f})")

def player():
    for p in ("pw-play", "paplay", "ffplay -nodisp -autoexit", "aplay"):
        if has(p.split()[0]):
            return p
    return None

def sound_preview(name=None):
    name = (name or "ctos-boot").strip()
    path = None
    if os.path.exists(os.path.expanduser(name)):
        path = os.path.expanduser(name)
    elif name in SOUNDS:
        path = os.path.expanduser(SOUNDS[name])
    if not path or not os.path.exists(path):
        die(f"Sound '{name}' was not found on this system. Run: tweakctl sound list")
    pl = player()
    if not pl:
        die("No audio player found (need pw-play, paplay, ffplay or aplay).")
    print(f"{BOLD}== Playing: {path} =={RESET}")
    r = run(pl.split() + [path], check=False)
    if r.returncode != 0:
        die(f"Playback failed: {(r.stderr or '').strip()}")
    ok_line("Playback finished.")

def sound_apply(name_or_path, volume="0.7"):
    path = None
    if os.path.exists(os.path.expanduser(name_or_path)):
        path = os.path.expanduser(name_or_path)
    elif name_or_path in SOUNDS:
        path = os.path.expanduser(SOUNDS[name_or_path])
    if not path or not os.path.exists(path):
        die(f"Sound '{name_or_path}' was not found on this system. Run: tweakctl sound list")
    pl = player()
    if not pl:
        die("No audio player found (need pw-play, paplay, ffplay or aplay).")
    if pl.split()[0] == "pw-play":
        play_cmd = f"/usr/bin/pw-play --volume={volume} {path}"
    elif pl.split()[0] == "paplay":
        play_cmd = f"/usr/bin/paplay --volume={int(float(volume)*65536)} {path}"
    else:
        play_cmd = f"{pl} {path}"
    print(f"Setting startup sound: {path} (volume {volume}, player {pl.split()[0]})")
    unit = os.path.expanduser("~/.config/systemd/user/ctos-boot-sound.service")
    os.makedirs(os.path.dirname(unit), exist_ok=True)
    if os.path.exists(unit):
        run(["sed","-i",f"s|ExecStart=.*|ExecStart={_sed_repl(play_cmd)}|",unit])
    else:
        with open(unit, "w") as f:
            f.write("[Unit]\nDescription=ctOS boot sound\nAfter=graphical.target\n"
                    "[Service]\nType=oneshot\n"
                    f"ExecStart={play_cmd}\n"
                    "[Install]\nWantedBy=default.target\n")
    run(["systemctl","--user","daemon-reload"], check=False)
    run(["systemctl","--user","enable","ctos-boot-sound.service"], check=False)
    ok_line(f"Startup sound set: {path} (plays at every login)")
    print(f"  Test command: {play_cmd}")

