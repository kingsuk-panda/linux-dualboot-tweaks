    def put(scr, y, x, text, attr=0):
        h, w = scr.getmaxyx()
        if y < 0 or y >= h or x < 0 or x >= w:
            return
        text = text.replace("\t", "    ").replace("\n", "")
        limit = w - x - 1          # never touch the bottom-right corner
        if limit <= 0:
            return
        try:
            scr.addstr(y, x, text[:limit], attr)
        except curses.error:
            pass

    def wrap(text, width):
        out, cur = [], ""
        for word in text.split():
            if cur and len(cur) + 1 + len(word) > width:
                out.append(cur)
                cur = word
            else:
                cur = f"{cur} {word}".strip()
        if cur:
            out.append(cur)
        return out

    def logo_splash(stdscr):
        """Animated startup logo (~0.9s) — any key skips it."""
        import time
        h, w = stdscr.getmaxyx()
        if h < 10 or w < 44:
            return
        green = (curses.color_pair(1) | curses.A_BOLD) if curses.has_colors() else curses.A_BOLD
        bold = curses.A_BOLD
        dim = curses.A_DIM
        sliders = [
            "  ━━●━━━━━━━━━━━━━━━━━━━━━━━━━━━",
            "  ━━━━━━●━━━━━━━━━━━━━━━━━━━━━━━",
            "  ━━━━━━━━━●━━━━━━━━━━━━━━━━━━━━",
        ]
        word = "tweakctl"
        tag = f" v{ver_short}   hibernate · S3 sleep · boot splash · ctOS sounds"
        width = max(len(sliders[0]), len(tag))
        cx = max(0, (w - width) // 2)
        cy = max(1, h // 2 - 3)

        def draw(n_sliders, n_letters, show_tag):
            stdscr.erase()
            for i in range(3):
                if i < n_sliders:
                    put(stdscr, cy + i, cx, sliders[i], green)
            put(stdscr, cy + 4, cx + 2, word[:n_letters], bold)
            if show_tag:
                put(stdscr, cy + 6, cx, tag, dim)
            stdscr.refresh()

        # reveal plan: sliders, then the wordmark types on, then the tagline
        steps = [(i + 1, 0, False) for i in range(3)]
        steps += [(3, i + 1, False) for i in range(len(word))]
        steps.append((3, len(word), True))
        stdscr.erase()
        stdscr.timeout(0)
        try:
            for n_s, n_l, tag_on in steps:
                draw(n_s, n_l, tag_on)
                time.sleep(0.07 if n_l == 0 else (0.03 if not tag_on else 0.1))
                if stdscr.getch() != -1:
                    break
            draw(3, len(word), True)
            stdscr.refresh()
            time.sleep(0.15)
            if stdscr.getch() == -1:
                time.sleep(0.2)
        finally:
            stdscr.timeout(-1)

