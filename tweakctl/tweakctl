#!/usr/bin/env python3
"""tweakctl — one CLI to check/enable hibernation, S3 sleep, Plymouth themes, and ctOS sounds.

Distro-agnostic: Arch, Ubuntu/Debian, Fedora/RHEL.
"""
import argparse, os, re, shutil, subprocess, sys, urllib.request, json, platform

VERSION = "0.3.0"
GH_REPO = "kingsuk-panda/linux-hibernate-dual-boot-tweaks"
RAW = f"https://raw.githubusercontent.com/{GH_REPO}/main/{{}}"

# ---------- helpers ----------
def run(cmd, sudo=False, check=True):
    if sudo:
        cmd = ["sudo"] + cmd
    try:
        return subprocess.run(cmd, check=check, text=True, capture_output=True)
    except subprocess.CalledProcessError as e:
        print(f"ERROR running {' '.join(cmd)}:\n{e.stderr}", file=sys.stderr)
        if check: sys.exit(1)
        return e

def has(cmd): return shutil.which(cmd) is not None

def distro():
    try:
        with open("/etc/os-release") as f:
            data = dict(l.strip().split("=",1) for l in f if "=" in l)
        return data["ID"], data.get("ID_LIKE","")
    except FileNotFoundError:
        return "unknown", ""

def die(msg): print(f"[FAIL] {msg}", file=sys.stderr); sys.exit(1)

def write_root(path, text):
    """Write a file as root (directly if already root, else via sudo tee)."""
    if os.geteuid() == 0:
        with open(path, "w") as f:
            f.write(text)
        return
    p = subprocess.run(["sudo", "tee", path], input=text, text=True, capture_output=True)
    if p.returncode != 0:
        die(f"Could not write {path}: {p.stderr.strip()}")

def grub_set_param(param, value, path="/etc/default/grub"):
    """Add or replace one kernel param inside GRUB_CMDLINE_LINUX_DEFAULT,
    preserving every other argument the user has."""
    txt = open(path).read()
    m = re.search(r'^GRUB_CMDLINE_LINUX_DEFAULT="([^"]*)"', txt, re.M)
    if m:
        args = [a for a in m.group(1).split() if not a.startswith(param + "=")]
        args.append(f"{param}={value}")
        txt = txt[:m.start()] + f'GRUB_CMDLINE_LINUX_DEFAULT="{" ".join(args)}"' + txt[m.end():]
    else:
        txt = txt.rstrip("\n") + f'\nGRUB_CMDLINE_LINUX_DEFAULT="{param}={value}"\n'
    write_root(path, txt)

RED = "\033[91m"; GREEN = "\033[92m"; YELLOW = "\033[93m"; BOLD = "\033[1m"; RESET = "\033[0m"
def ok_line(msg):    print(f"{GREEN}{BOLD}[OK]{RESET} {msg}")
def fail_line(msg):  print(f"{RED}{BOLD}[FAIL]{RESET} {msg}")
def warn_line(msg):  print(f"{YELLOW}{BOLD}[WARN]{RESET} {msg}")

# ---------- hibernation ----------
def hibernate_check():
    print(f"{BOLD}== Hibernation check =={RESET}")
    st = open("/sys/power/state").read().strip() if os.path.exists("/sys/power/state") else ""
    swaps = []
    if os.path.exists("/proc/swaps"):
        for line in open("/proc/swaps").read().splitlines()[1:]:
            parts = line.split()
            swaps.append((parts[0], int(parts[2])/1024/1024))
    cmdline = open("/proc/cmdline").read()
    fstab = open("/etc/fstab").read()
    has_resume_param = "resume=" in cmdline
    has_mkcpio = os.path.exists("/etc/mkinitcpio.conf") and "resume" in open("/etc/mkinitcpio.conf").read()
    has_initramfs_tools = os.path.exists("/etc/initramfs-tools") and any("RESUME=" in open(os.path.join(r,f), errors="ignore").read() for r,_,files in os.walk("/etc/initramfs-tools") for f in files)
    in_fstab = False
    for dev, _ in swaps:
        uuid = re.search(r'UUID="([^"]+)"', run(["blkid", dev], sudo=True, check=False).stdout or "")
        if dev in fstab or (uuid and uuid.group(1) in fstab):
            in_fstab = True
            break
    mem = os.sysconf("SC_PAGE_SIZE") * os.sysconf("SC_PHYS_PAGES") / 1024**3
    if "disk" in st:
        ok_line("Kernel supports hibernation (S4 'disk' state). States: " + st)
    else:
        fail_line(f"HIBERNATION IS NOT SUPPORTED. /sys/power/state = '{st or 'empty'}'.")
    if swaps:
        for dev, sz in swaps:
            print(f"  swap: {dev} {sz:.0f} GiB")
        if max(s for _,s in swaps) >= mem*0.9:
            ok_line(f"Swap large enough ({max(s for _,s in swaps):.0f} GiB vs ~{mem:.0f} GiB RAM).")
        else:
            fail_line(f"Swap too small ({max(s for _,s in swaps):.0f} GiB). Needs ≈ RAM ({mem:.0f} GiB).")
    else:
        fail_line("No swap configured. Hibernation impossible without swap.")
    if in_fstab:
        ok_line("Swap is in /etc/fstab (auto-mounts at boot).")
    else:
        warn_line("Swap is NOT in /etc/fstab — resume may fail on cold boot.")
    if has_resume_param:
        ok_line("Kernel cmdline has resume= param.")
    else:
        fail_line("Kernel has NO resume= param — hibernated session won't be found.")
    if os.path.exists("/etc/mkinitcpio.conf"):
        ok_line("mkinitcpio has resume hook.") if has_mkcpio else fail_line("mkinitcpio is MISSING the resume hook.")
    if os.path.exists("/usr/lib/dracut") or os.path.exists("/usr/bin/dracut"):
        print("  [..] Fedora/RHEL: resume handled by dracut when resume= is set")
    if os.path.exists("/etc/initramfs-tools"):
        ok_line("Ubuntu initramfs-tools RESUME= set.") if has_initramfs_tools else fail_line("Ubuntu initramfs-tools RESUME= missing.")
    print()
    if "disk" in st and swaps and has_resume_param and in_fstab and (has_mkcpio or has_initramfs_tools or os.path.exists('/usr/bin/dracut')):
        print(f"{GREEN}{BOLD}>>> HIBERNATION IS ALREADY IMPLEMENTED ON THIS DEVICE — schedule with: systemctl hibernate <<<{RESET}")
    else:
        print(f"{RED}{BOLD}>>> HIBERNATION IS NOT FULLY SET UP — run: sudo tweakctl hibernate enable <<<{RESET}")

def hibernate_enable():
    # swap must be active
    active = []
    if os.path.exists("/proc/swaps"):
        for line in open("/proc/swaps").read().splitlines()[1:]:
            active.append(line.split()[0])
    if not active:
        die("No swap active. Create swap >= RAM first.")
    # Prefer the UUID of an *active* swap device, then any swap partition.
    swap_uuid = None
    out = run(["blkid"], sudo=True, check=False).stdout
    for dev in active + [l.split()[0] for l in out.splitlines()]:
        m = re.search(r'UUID="([^"]+)"', run(["blkid", dev], check=False).stdout or "")
        if m:
            swap_uuid = m.group(1)
            break
    if not swap_uuid:
        die("Could not find any swap UUID.")
    d, _ = distro()
    print(f"Detected distro: {d}")
    if d in ("arch",):
        grub_set_param("resume", f"UUID={swap_uuid}")
        grub_set_param("mem_sleep_default", "deep")
        mc = open("/etc/mkinitcpio.conf").read()
        if not re.search(r'HOOKS=\([^)]*\bresume\b', mc):
            run(["sed","-i","s/filesystems/resume filesystems/","/etc/mkinitcpio.conf"], sudo=True)
        run(["grub-mkconfig","-o","/boot/grub/grub.cfg"], sudo=True)
        run(["mkinitcpio","-P"], sudo=True)
    elif d in ("ubuntu","debian","pop","linuxmint"):
        write_root("/etc/initramfs-tools/conf.d/resume", f"RESUME=UUID={swap_uuid}\n")
        grub_set_param("resume", f"UUID={swap_uuid}")
        run(["update-initramfs","-u"], sudo=True)
        if has("update-grub"):
            run(["update-grub"], sudo=True)
        else:
            run(["grub-mkconfig","-o","/boot/grub/grub.cfg"], sudo=True)
    elif d in ("fedora","rhel","centos","rocky","alma","opensuse-leap","opensuse-tumbleweed"):
        run(["grubby","--update-kernel=ALL",f"--args=resume=UUID={swap_uuid}"], sudo=True)
        run(["dracut","--regenerate-all","--force"], sudo=True)
    else:
        print(f"Distro '{d}' not fully supported for auto-setup. Add resume=UUID={swap_uuid} manually.")
    # fstab
    fstab = open("/etc/fstab").read()
    if swap_uuid not in fstab:
        write_root("/etc/fstab", fstab + f"UUID={swap_uuid} none swap defaults 0 0\n")
    print("Hibernation enabled. Reboot and test: systemctl hibernate")

# ---------- s3 ----------
def s3_check():
    print(f"{BOLD}== S3 sleep check =={RESET}")
    if os.path.exists("/sys/power/mem_sleep"):
        line = open("/sys/power/mem_sleep").read().strip()
        print(f"  mem_sleep modes: {line}")
        if "deep" in line:
            ok_line("S3 (deep) sleep is available on this hardware.")
        else:
            fail_line("S3 (deep) sleep is NOT available on this hardware.")
        if "[deep]" in line:
            ok_line("S3 (deep) is currently the ACTIVE suspend mode.")
        else:
            warn_line("S3 (deep) is NOT the active mode — run: sudo tweakctl s3 set-deep")
    else:
        fail_line("/sys/power/mem_sleep missing — ACPI issue.")
    if "mem_sleep_default=deep" in open("/proc/cmdline").read():
        ok_line("mem_sleep_default=deep persists across reboots.")
    else:
        warn_line("mem_sleep_default=deep NOT set on kernel cmdline.")
    print()
    if os.path.exists("/sys/power/mem_sleep") and "[deep]" in open("/sys/power/mem_sleep").read():
        print(f"{GREEN}{BOLD}>>> S3 DEEP SLEEP IS ACTIVE <<<{RESET}")
    else:
        print(f"{YELLOW}{BOLD}>>> S3 DEEP SLEEP IS NOT ACTIVE <<<{RESET}")

def s3_set(mode="deep"):
    d, _ = distro()
    if d in ("arch","ubuntu","debian","pop","linuxmint"):
        grub_set_param("mem_sleep_default", mode)
        if has("update-grub"):
            run(["update-grub"], sudo=True)
        else:
            run(["grub-mkconfig","-o","/boot/grub/grub.cfg"], sudo=True)
    elif d in ("fedora","rhel","centos","rocky","alma"):
        run(["grubby","--update-kernel=ALL",f"--args=mem_sleep_default={mode}"], sudo=True)
    else:
        die(f"Distro '{d}' not supported for S3 toggle.")
    # try to apply immediately for the current session too
    run(["bash","-c",f"echo {mode} > /sys/power/mem_sleep"], sudo=True, check=False)
    if os.path.exists("/sys/power/mem_sleep") and f"[{mode}]" in open("/sys/power/mem_sleep").read():
        print(f"S3 mode set to '{mode}' — active now and saved across reboots.")
    else:
        print(f"mem_sleep_default={mode} saved — reboot to apply.")

# ---------- plymouth ----------
def plymouth_check():
    print(f"{BOLD}== Plymouth check =={RESET}")
    if has('plymouth') or os.path.exists('/usr/share/plymouth'):
        ok_line("Plymouth is installed.")
    else:
        fail_line("Plymouth is NOT installed.")
    cfg = "/etc/plymouth/plymouthd.conf"
    if os.path.exists(cfg):
        m = re.search(r"Theme=(.+)", open(cfg).read())
        print(f"  Current theme: {m.group(1) if m else 'default'}")
    themes_dir = "/usr/share/plymouth/themes"
    if os.path.exists(themes_dir):
        print(f"  Installed themes: {', '.join(os.listdir(themes_dir))}")
    if os.path.exists('/etc/mkinitcpio.conf'):
        if 'plymouth' in open('/etc/mkinitcpio.conf').read():
            ok_line("mkinitcpio has plymouth hook.")
        else:
            fail_line("mkinitcpio MISSING plymouth hook.")
    if 'splash' in open('/proc/cmdline').read():
        ok_line("Kernel has 'splash'.")
    else:
        warn_line("Kernel missing 'splash' — plymouth won't show.")

def plymouth_apply(theme):
    if not theme:
        d = "/usr/share/plymouth/themes"
        if not os.path.exists(d): die("Plymouth not installed.")
        theme = input(f"Available: {os.listdir(d)}\nTheme name: ").strip()
    if not os.path.exists(f"/usr/share/plymouth/themes/{theme}"):
        die(f"Theme '{theme}' not installed. Available: {os.listdir('/usr/share/plymouth/themes') if os.path.exists('/usr/share/plymouth/themes') else 'none'}")
    run(["plymouth-set-default-theme", theme], sudo=True, check=False)
    cfg = "/etc/plymouth/plymouthd.conf"
    if os.path.exists(cfg):
        run(["sed","-i",f"s/^Theme=.*/Theme={theme}/",cfg], sudo=True)
    d,_ = distro()
    if d=="arch": run(["mkinitcpio","-P"], sudo=True)
    elif d in ("ubuntu","debian"): run(["update-initramfs","-u"], sudo=True)
    elif d in ("fedora","rhel","centos"): run(["dracut","--regenerate-all","--force"], sudo=True)
    print(f"Plymouth theme set to '{theme}'. Reboot.")

# ---------- ctos sound ----------
SOUNDS = {
    "ctos-boot": "~/.local/share/sounds/ctos-boot.ogg",
    "ctos-shutdown": "/usr/share/sounds/ctos/ctos-shutdown.ogg",
}
def sound_list():
    print("Available built-in ctOS sounds:")
    for name, path in SOUNDS.items():
        expanded = os.path.expanduser(path)
        print(f"  {name:15s} {'present' if os.path.exists(expanded) else 'missing'} ({expanded})")
    for d in ["~/.local/share/sounds", "/usr/share/sounds/ctos"]:
        p = os.path.expanduser(d)
        if os.path.exists(p):
            for f in os.listdir(p):
                if f.endswith(('.ogg','.wav','.mp3')) and f not in [os.path.basename(v) for v in SOUNDS.values()]:
                    print(f"  {f:30s} ({p}/{f})")

def player():
    for p in ("pw-play", "paplay", "ffplay -nodisp -autoexit", "aplay"):
        if has(p.split()[0]):
            return p
    return None

def sound_apply(name_or_path, volume="0.7"):
    path = None
    if os.path.exists(os.path.expanduser(name_or_path)):
        path = os.path.expanduser(name_or_path)
    elif name_or_path in SOUNDS:
        path = os.path.expanduser(SOUNDS[name_or_path])
    if not path or not os.path.exists(path):
        die(f"Sound '{name_or_path}' not found. Run `tweakctl sound list`.")
    pl = player()
    if not pl:
        die("No audio player found (need pw-play, paplay, ffplay or aplay).")
    if pl.split()[0] == "pw-play":
        play_cmd = f"/usr/bin/pw-play --volume={volume} {path}"
    elif pl.split()[0] == "paplay":
        play_cmd = f"/usr/bin/paplay --volume={int(float(volume)*65536)} {path}"
    else:
        play_cmd = f"{pl} {path}"
    print(f"Applying boot sound: {path} (volume {volume}, player {pl.split()[0]})")
    unit = os.path.expanduser("~/.config/systemd/user/ctos-boot-sound.service")
    os.makedirs(os.path.dirname(unit), exist_ok=True)
    if os.path.exists(unit):
        run(["sed","-i",f"s|ExecStart=.*|ExecStart={play_cmd}|",unit])
    else:
        with open(unit, "w") as f:
            f.write("[Unit]\nDescription=ctOS boot sound\nAfter=graphical.target\n"
                    "[Service]\nType=oneshot\n"
                    f"ExecStart={play_cmd}\n"
                    "[Install]\nWantedBy=default.target\n")
    run(["systemctl","--user","daemon-reload"], check=False)
    run(["systemctl","--user","enable","ctos-boot-sound.service"], check=False)
    ok_line(f"Boot sound set: {path}")
    print(f"  Preview: {play_cmd}")

# ---------- update check ----------
def update_check():
    try:
        url = f"https://api.github.com/repos/{GH_REPO}/releases/latest"
        with urllib.request.urlopen(url, timeout=10) as r:
            data = json.loads(r.read())
        latest = data["tag_name"].lstrip("v")
        if latest != VERSION:
            print(f"Update available: {VERSION} → {latest}")
            print(f"Download: {data['html_url']}")
        else:
            print(f"tweakctl is up to date (v{VERSION}).")
    except Exception as e:
        print(f"Could not check for updates: {e}")

# ---------- TUI ----------
def tui():
    import curses, io, contextlib, re as _re
    ANSI = _re.compile(r"\033\[[0-9;]*m")
    ver_short = VERSION
    did, _ = distro()

    # (label, action, needs_root)
    MENU = [
        ("Hibernate  > Check status",        lambda: hibernate_check(),        False),
        ("Hibernate  > Enable",              lambda: hibernate_enable(),       True),
        ("S3 sleep   > Check",               lambda: s3_check(),               False),
        ("S3 sleep   > Set deep",            lambda: s3_set("deep"),           True),
        ("S3 sleep   > Set s2idle",          lambda: s3_set("s2idle"),         True),
        ("Plymouth   > Check",               lambda: plymouth_check(),         False),
        ("Plymouth   > Apply theme",         "PROMPT_THEME",                   True),
        ("Sound      > List",                lambda: sound_list(),             False),
        ("Sound      > Apply",               "PROMPT_SOUND",                   False),
        ("Update     > Check for updates",   lambda: update_check(),           False),
        ("About / Quit",                     None,                             False),
    ]

    def put(scr, y, x, text, attr=0):
        h, w = scr.getmaxyx()
        if y < 0 or y >= h or x < 0 or x >= w:
            return
        text = text.replace("\t", "    ").replace("\n", "")
        limit = w - x - 1          # never touch the bottom-right corner
        if limit <= 0:
            return
        try:
            scr.addstr(y, x, text[:limit], attr)
        except curses.error:
            pass

    def ensure_sudo(stdscr):
        """Ask for the sudo password once, on a clean screen outside curses."""
        if os.geteuid() == 0 or not has("sudo"):
            return True
        try:
            curses.def_prog_mode()
            curses.endwin()
            print("\nAdministrator rights required — enter your sudo password.")
            rc = subprocess.run(["sudo", "-v"], check=False).returncode
        finally:
            curses.reset_prog_mode()
            stdscr.refresh()
        return rc == 0

    def line_attr(scr, line):
        if line.startswith("[OK]"):
            return curses.color_pair(1) | curses.A_BOLD
        if line.startswith("[FAIL]"):
            return curses.color_pair(2) | curses.A_BOLD
        if line.startswith("[WARN]"):
            return curses.color_pair(3) | curses.A_BOLD
        if ">>>" in line:                      # summary banner
            if "NOT SUPPORTED" in line or "NOT FULLY" in line:
                return curses.color_pair(2) | curses.A_BOLD
            if "NOT" in line:
                return curses.color_pair(3) | curses.A_BOLD
            return curses.color_pair(1) | curses.A_BOLD
        if line.startswith("=="):
            return curses.A_BOLD
        if line.startswith("  [..]"):
            return curses.color_pair(4)
        return 0

    def loop(stdscr):
        nonlocal sel, offset
        if curses.has_colors():
            curses.start_color()
            curses.use_default_colors()
            curses.init_pair(1, curses.COLOR_GREEN, -1)
            curses.init_pair(2, curses.COLOR_RED, -1)
            curses.init_pair(3, curses.COLOR_YELLOW, -1)
            curses.init_pair(4, curses.COLOR_CYAN, -1)
        curses.curs_set(0)
        stdscr.keypad(True)
        output = [
            f"tweakctl v{ver_short} — {did} — ↑/↓ move · Enter run · PgUp/PgDn scroll · q quit",
            "Pick an action on the left; its output appears here.",
            "",
        ]
        offset = 0                      # lines scrolled back from the bottom
        while True:
            stdscr.erase()
            h, w = stdscr.getmaxyx()
            out_x = min(36, max(24, w // 2))

            put(stdscr, 0, 0, f" tweakctl v{ver_short} · {did} ", curses.A_REVERSE)
            put(stdscr, 0, out_x, " Output ", curses.A_REVERSE)
            put(stdscr, 1, out_x, "─" * max(1, w - out_x - 1), curses.A_DIM)

            for i, (label, _, _) in enumerate(MENU):
                if i + 2 >= h - 1:
                    break
                if i == sel:
                    put(stdscr, i + 2, 0, f"> {label}", curses.A_REVERSE | curses.A_BOLD)
                else:
                    put(stdscr, i + 2, 0, f"  {label}", curses.A_DIM if i == len(MENU) - 1 else 0)

            body = h - 4               # header(2) + footer(1) + spare
            start = max(0, len(output) - body - offset)
            end = max(0, len(output) - offset)
            for j, line in enumerate(output[start:end]):
                put(stdscr, j + 2, out_x, line, line_attr(stdscr, line))

            footer = " ↑/↓ Enter PgUp/PgDn scroll q quit "
            put(stdscr, h - 1, 0, footer, curses.A_REVERSE)
            if offset:
                put(stdscr, h - 1, max(0, w - 14), f" {offset}↑ ", curses.A_REVERSE)
            stdscr.refresh()

            k = stdscr.getch()
            if k in (ord("q"), ord("Q"), 27):
                break
            elif k == curses.KEY_UP:
                sel = (sel - 1) % len(MENU)
            elif k == curses.KEY_DOWN:
                sel = (sel + 1) % len(MENU)
            elif k == curses.KEY_PPAGE:
                offset = min(len(output) - 1, offset + body)
            elif k == curses.KEY_NPAGE:
                offset = max(0, offset - body)
            elif k in (10, 13, curses.KEY_ENTER):
                offset = 0
                label, fn, needs_root = MENU[sel]
                if fn is None:
                    break
                if needs_root and not ensure_sudo(stdscr):
                    output = ["[FAIL] sudo authentication failed — action cancelled.", ""]
                    continue
                buf = io.StringIO()
                try:
                    with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
                        if fn == "PROMPT_THEME":
                            themes = sorted(os.listdir("/usr/share/plymouth/themes")) \
                                if os.path.exists("/usr/share/plymouth/themes") else []
                            val = prompt_line(stdscr, h, out_x,
                                              f"Theme ({'/'.join(themes) or 'none'}): ")
                            if val:
                                plymouth_apply(val)
                            else:
                                buf.write("Cancelled.\n")
                        elif fn == "PROMPT_SOUND":
                            val = prompt_line(stdscr, h, out_x, "Sound name/path: ")
                            if val:
                                sound_apply(val, "0.7")
                            else:
                                buf.write("Cancelled.\n")
                        else:
                            fn()
                except SystemExit:
                    pass                # die() already wrote to the captured stream
                except KeyboardInterrupt:
                    buf.write("\nInterrupted.\n")
                except Exception as e:
                    buf.write(f"\n[ERROR] {e}\n")
                cleaned = ANSI.sub("", buf.getvalue()) or "(no output)"
                output = cleaned.splitlines()

    def prompt_line(stdscr, h, x, text):
        """Single-line input on the last row; returns stripped text or ''."""
        curses.echo()
        curses.curs_set(1)
        try:
            stdscr.move(h - 1, 0)
            stdscr.clrtoeol()
            put(stdscr, h - 1, x, text, curses.A_BOLD)
            stdscr.refresh()
            val = stdscr.getstr(h - 1, min(x + len(text), stdscr.getmaxyx()[1] - 2), 60)
            return val.decode(errors="replace").strip()
        finally:
            curses.noecho()
            curses.curs_set(0)
            stdscr.clrtoeol()
            stdscr.refresh()

    sel, offset = 0, 0
    curses.wrapper(loop)

def main():
    p = argparse.ArgumentParser(prog="tweakctl", description="Linux hibernation/S3/plymouth/ctOS tuner for Arch, Ubuntu, Fedora")
    p.add_argument("--version", action="version", version=VERSION)
    sub = p.add_subparsers(dest="command")
    hib = sub.add_parser("hibernate"); hib.add_argument("action", choices=["check","enable"])
    s3 = sub.add_parser("s3"); s3.add_argument("action", choices=["check","enable","set-deep","set-s2idle"])
    pl = sub.add_parser("plymouth"); pl.add_argument("action", choices=["check","apply"]); pl.add_argument("--theme")
    so = sub.add_parser("sound"); so.add_argument("action", choices=["list","apply"]); so.add_argument("--name"); so.add_argument("--volume", default="0.7")
    sub.add_parser("update-check")
    sub.add_parser("tui")
    a = p.parse_args()
    if a.command is None:
        if sys.stdin.isatty() and sys.stdout.isatty():
            tui()
        else:
            p.print_help()
            print("\n(no TTY detected — showing help instead of the interactive UI)")
        return
    if a.command == "tui":
        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            die("`tweakctl tui` needs an interactive terminal.")
        tui()
        return
    if a.command == "hibernate":
        hibernate_check() if a.action=="check" else hibernate_enable()
    elif a.command == "s3":
        if a.action == "check": s3_check()
        elif a.action in ("enable","set-deep"): s3_set("deep")
        else: s3_set("s2idle")
    elif a.command == "plymouth":
        plymouth_check() if a.action=="check" else plymouth_apply(a.theme)
    elif a.command == "sound":
        sound_list() if a.action=="list" else sound_apply(a.name or input("Sound name/path: "), a.volume)
    elif a.command == "update-check":
        update_check()
    else:
        p.print_help()

if __name__ == "__main__":
    main()
