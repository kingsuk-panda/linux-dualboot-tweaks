    def read_key(scr):
        """getch that also understands terminals sending raw \x1b[A/B sequences."""
        k = scr.getch()
        if k != 27:
            return k
        scr.timeout(50)
        try:
            n = scr.getch()
            if n == -1:
                return 27                       # plain Esc
            if n == ord("["):
                m = scr.getch()
                if m == ord("A"):
                    return curses.KEY_UP
                if m == ord("B"):
                    return curses.KEY_DOWN
                if m == ord("H"):
                    return curses.KEY_HOME
                if m == ord("F"):
                    return curses.KEY_END
                if m in (ord("5"), ord("6")):
                    scr.getch()                 # consume trailing '~'
                    return curses.KEY_PPAGE if m == ord("5") else curses.KEY_NPAGE
                if m in (ord("1"), ord("4")):
                    scr.getch()                 # consume trailing '~'
                    return curses.KEY_HOME if m == ord("1") else curses.KEY_END
            return -1
        finally:
            scr.timeout(-1)

    def choose_list(stdscr, title, items, start=0):
        """Modal picker: ↑/↓ or j/k move, Home/End, PgUp/PgDn, first-letter jump,
        Enter selects, Esc/q cancels. items = [(label, value)] -> value or None."""
        if not items:
            return None
        idx = max(0, min(start, len(items) - 1))
        top = 0
        while True:
            h, w = stdscr.getmaxyx()
            stdscr.erase()
            put(stdscr, 0, 0, f" {title} ", curses.A_REVERSE)
            put(stdscr, 1, 0, "─" * max(1, min(w - 1, 60)), curses.A_DIM)
            rows = max(1, h - 4)
            top = max(0, min(top, len(items) - rows)) if len(items) > rows else 0
            if idx < top:
                top = idx
            if idx >= top + rows:
                top = idx - rows + 1
            for i in range(rows):
                j = top + i
                if j >= len(items):
                    break
                if j == idx:
                    put(stdscr, 2 + i, 0, f"▶ {items[j][0]}",
                        curses.A_REVERSE | curses.A_BOLD)
                else:
                    put(stdscr, 2 + i, 0, f"  {items[j][0]}")
            put(stdscr, h - 1, 0, " ↑/↓ j/k move · Enter select · Esc cancel ",
                curses.A_REVERSE)
            put(stdscr, h - 1, max(0, w - 9), f" {idx + 1}/{len(items)} ",
                curses.A_REVERSE)
            stdscr.refresh()
            k = read_key(stdscr)
            if k in (ord("q"), ord("Q"), 27):
                return None
            if k in (curses.KEY_UP, ord("k")):
                idx = (idx - 1) % len(items)
            elif k in (curses.KEY_DOWN, ord("j")):
                idx = (idx + 1) % len(items)
            elif k == curses.KEY_HOME:
                idx = 0
            elif k == curses.KEY_END:
                idx = len(items) - 1
            elif k == curses.KEY_PPAGE:
                idx = max(0, idx - rows)
            elif k == curses.KEY_NPAGE:
                idx = min(len(items) - 1, idx + rows)
            elif k in (10, 13, curses.KEY_ENTER):
                return items[idx][1]
            elif 32 <= k < 127:                    # first-letter jump
                ch = chr(k).lower()
                for off in range(1, len(items) + 1):
                    j = (idx + off) % len(items)
                    if items[j][0].lower().lstrip("> ").startswith(ch):
                        idx = j
                        break

    def ensure_sudo(stdscr):
        """Ask for the sudo password once, on a clean screen outside curses."""
        if os.geteuid() == 0 or not has("sudo"):
            return True
        try:
            curses.def_prog_mode()
            curses.endwin()
            print("\nAdministrator rights required — enter your sudo password.")
            rc = subprocess.run(["sudo", "-v"], check=False).returncode
        finally:
            curses.reset_prog_mode()
            stdscr.refresh()
        return rc == 0

    def perform(action, val, sink):
        """Run the chosen action; write its output to sink (None = live screen)."""
        def body():
            if action == "CHOOSE_THEME":
                plymouth_apply(val)
            elif action == "CHOOSE_THEME_PREVIEW":
                plymouth_preview(val)
            elif action == "CHOOSE_SOUND_APPLY":
                sound_apply(val, "0.7")
            elif action == "CHOOSE_SOUND_PREVIEW":
                sound_preview(val)
            else:
                action()
        if sink is None:
            body()
        else:
            with contextlib.redirect_stdout(sink), contextlib.redirect_stderr(sink):
                body()

    def line_level(line):
        """Colour class of an output line (kept across wrapped continuations)."""
        if line.startswith("[OK]"):   return "ok"
        if line.startswith("[FAIL]"): return "fail"
        if line.startswith("[WARN]"): return "warn"
        if ">>>" in line:                     # summary banner
            if "NOT SUPPORTED" in line or "NOT FULLY" in line:
                return "banner-bad"
            if "NOT" in line:
                return "banner-warn"
            return "banner-ok"
        if line.startswith("=="):     return "head"
        if line.startswith("  [..]"): return "info"
        return ""

    def fit(lines, width):
        """Wrap output lines to the pane width so nothing is cut off.
        Continuation rows carry a 3-space indent, so they wrap at width-3."""
        out = []
        cont = max(12, width - 3)
        for ln in lines:
            lv = line_level(ln)
            if len(ln) <= width:
                parts = [ln]
            else:
                parts = []
                for p in (wrap(ln, cont) or [ln]):
                    while len(p) > cont:      # hard-split words longer than the pane
                        parts.append(p[:cont])
                        p = p[cont:]
                    parts.append(p)
            for i, p in enumerate(parts):
                out.append((("   " + p) if i else p, lv))
        return out

    def level_attr(lv):
        if not curses.has_colors():
            return curses.A_BOLD if lv.startswith("banner") or lv == "head" else 0
        return {
            "ok":          curses.color_pair(1) | curses.A_BOLD,
            "banner-ok":   curses.color_pair(1) | curses.A_BOLD,
            "fail":        curses.color_pair(2) | curses.A_BOLD,
            "banner-bad":  curses.color_pair(2) | curses.A_BOLD,
            "warn":        curses.color_pair(3) | curses.A_BOLD,
            "banner-warn": curses.color_pair(3) | curses.A_BOLD,
            "info":        curses.color_pair(4),
            "head":        curses.A_BOLD,
        }.get(lv, 0)

    def loop(stdscr):
        nonlocal offset
        if curses.has_colors():
            curses.start_color()
            curses.use_default_colors()
            curses.init_pair(1, curses.COLOR_GREEN, -1)
            curses.init_pair(2, curses.COLOR_RED, -1)
            curses.init_pair(3, curses.COLOR_YELLOW, -1)
            curses.init_pair(4, curses.COLOR_CYAN, -1)
        curses.curs_set(0)
        stdscr.keypad(True)
        try:
            curses.set_escdelay(50)      # Esc must cancel/quit instantly (ncurses: 1000ms)
        except (AttributeError, curses.error):
            pass
        logo_splash(stdscr)
        if not disclaimer_accepted():
            if not disclaimer_screen(stdscr):        # 'n'/Esc/q — leave untouched
                return
        output = None                  # built on the first frame (pane width known)
        offset = 0                      # lines scrolled back from the bottom
        top_view = False                # next output starts at its first line
        while True:
            stdscr.erase()
            h, w = stdscr.getmaxyx()
            out_x = min(36, max(24, w // 2))
            pane_w = w - out_x - 1
            if output is None:
                output = fit([
                    f"tweakctl v{ver_short} — {did} — ↑/↓ or j/k · Enter run · PgUp/PgDn scroll · q quit",
                    "Pick an action on the left; its output appears on the right.",
                    "New here? Start with 'About & disclaimer' at the bottom.",
                    "",
                ], pane_w)

            put(stdscr, 0, 0, f" ━● tweakctl v{ver_short} · {did} ",
                curses.A_REVERSE | curses.A_BOLD)
            put(stdscr, 0, out_x, " Output ", curses.A_REVERSE)
            put(stdscr, 1, out_x, "─" * max(1, w - out_x - 1), curses.A_DIM)

            def move(delta):
                """Advance sel over selectable rows only (skip headers)."""
                nonlocal sel
                for _ in range(len(MENU)):
                    sel = (sel + delta) % len(MENU)
                    if not MENU[sel].get("header"):
                        return

            def go_first():
                nonlocal sel
                sel = next(i for i, e in enumerate(MENU) if not e.get("header"))

            def go_last():
                nonlocal sel
                sel = max(i for i, e in enumerate(MENU) if not e.get("header"))

            hdr_attr = (curses.color_pair(4) | curses.A_BOLD
                        ) if curses.has_colors() else curses.A_BOLD
            for i, entry in enumerate(MENU):
                if i + 2 >= h - 1:
                    break
                if entry.get("header"):
                    put(stdscr, i + 2, 0,
                        f"  {entry['glyph']}  {entry['header']}", hdr_attr)
                elif i == sel:
                    put(stdscr, i + 2, 0, f"▶ {entry['label']}",
                        curses.A_REVERSE | curses.A_BOLD)
                else:
                    dim = curses.A_DIM if entry["action"] is None else 0
                    put(stdscr, i + 2, 0, f"  {entry['label']}", dim)

            body = h - 4               # header(2) + footer(1) + spare
            if top_view:                # show long informational output from the top
                offset = max(0, len(output) - body)
                top_view = False
            start = max(0, len(output) - body - offset)
            end = max(0, len(output) - offset)
            for j, (line, lv) in enumerate(output[start:end]):
                put(stdscr, j + 2, out_x, line, level_attr(lv))

            put(stdscr, h - 1, 0, " ↑/↓ j/k · Enter run · PgUp/PgDn scroll · q/Esc quit ",
                curses.A_REVERSE)
            if offset:
                put(stdscr, h - 1, max(0, w - 14), f" {offset}↑ ", curses.A_REVERSE)
            stdscr.refresh()

            k = read_key(stdscr)
            if k in (ord("q"), ord("Q"), 27):
                break
            elif k in (curses.KEY_UP, ord("k")):
                move(-1)
            elif k in (curses.KEY_DOWN, ord("j")):
                move(1)
            elif k == curses.KEY_HOME:
                go_first()
            elif k == curses.KEY_END:
                go_last()
            elif k == curses.KEY_PPAGE:
                offset = min(len(output) - 1, offset + body)
            elif k == curses.KEY_NPAGE:
                offset = max(0, offset - body)
            elif k in (10, 13, curses.KEY_ENTER):
                offset = 0
                entry = MENU[sel]
                action = entry["action"]
                if action is None:
                    break
                # 1) selection (before anything else, so nothing runs on cancel)
                val = None
                if isinstance(action, str):
                    if action == "ABOUT":
                        status = disclaimer_status()
                        lines = [
                            f"tweakctl v{ver_short} — MIT licensed (ctOS sounds/Watch Dogs art © Ubisoft)",
                            f"Detected distro: {did}",
                            f"Repository: https://github.com/{GH_REPO}",
                            f"Disclaimer: {status if status else 'NOT accepted yet'}",
                            "",
                            "-- Disclaimer (full text) --",
                        ] + disclaimer_paragraphs()
                        output = fit(lines, pane_w)
                        top_view = True
                        continue
                    themes = installed_plymouth_themes()
                    cur_theme = current_plymouth_theme()
                    theme_items = [(f"{t}  • active" if t == cur_theme else t, t)
                                   for t in themes]
                    theme_start = next((i for i, (_, v) in enumerate(theme_items)
                                        if v == cur_theme), 0)
                    if action == "CHOOSE_THEME":
                        if not theme_items:
                            output = fit(["[FAIL] No plymouth themes installed.", ""], pane_w)
                            continue
                        val = choose_list(stdscr, " Change the boot theme — pick one ",
                                          theme_items, theme_start)
                    elif action == "CHOOSE_THEME_PREVIEW":
                        if not theme_items:
                            output = fit(["[FAIL] No plymouth themes installed.", ""], pane_w)
                            continue
                        val = choose_list(stdscr, " Preview which boot animation? ",
                                          theme_items, theme_start)
                    elif action in ("CHOOSE_SOUND_PREVIEW", "CHOOSE_SOUND_APPLY"):
                        choices = sound_choices()
                        if not choices:
                            output = fit(["[FAIL] No sound files found — run: tweakctl sound list",
                                          ""], pane_w)
                            continue
                        start = next((i for i, (_, v) in enumerate(choices)
                                      if v == current_boot_sound()), 0)
                        title = (" Which sound do you want to hear? "
                                 if action == "CHOOSE_SOUND_PREVIEW"
                                 else " Pick your startup sound ")
                        val = choose_list(stdscr, title, choices, start)
                    if val is None:
                        output = fit(["Cancelled — nothing was changed.", ""], pane_w)
                        continue
                # 2) already-enabled confirmation
                already = entry.get("already")
                if already and already(val):
                    if not confirm_screen(stdscr, entry["title"], entry["why"]):
                        output = fit(["Cancelled — nothing was changed.", ""], pane_w)
                        continue
                # 3) sudo (after the user has said yes)
                if entry.get("root") and not ensure_sudo(stdscr):
                    output = fit(["[FAIL] sudo authentication failed — action cancelled.",
                                  ""], pane_w)
                    continue
                # 4) run
                if entry.get("suspend"):
                    curses.def_prog_mode()
                    curses.endwin()
                    try:
                        perform(action, val, None)
                    except (SystemExit, KeyboardInterrupt):
                        pass
                    except Exception as e:
                        print(f"[ERROR] {e}")
                    finally:
                        curses.reset_prog_mode()
                        stdscr.refresh()
                    output = fit([f"Ran: {entry['label']}", "Back in tweakctl.", ""], pane_w)
                else:
                    buf = io.StringIO()
                    try:
                        perform(action, val, buf)
                    except SystemExit:
                        pass                # die() already wrote to the stream
                    except KeyboardInterrupt:
                        buf.write("\nInterrupted.\n")
                    except Exception as e:
                        buf.write(f"\n[ERROR] {e}\n")
                    cleaned = ANSI.sub("", buf.getvalue()) or "(no output)"
                    output = fit(cleaned.splitlines(), pane_w)

    sel = next(i for i, e in enumerate(MENU) if not e.get("header"))
    offset = 0
    curses.wrapper(loop)

def _desktop_content(bindir):
    return f"""[Desktop Entry]
Type=Application
Name=Tweakctl
GenericName=System Tweaks
Comment=Hibernation, S3 sleep, Plymouth boot splash and ctOS sounds
Exec={os.path.join(bindir, "tweakctl")} gui
Icon=tweakctl
Categories=System;
Terminal=false
"""


def install():
    """Install tweakctl to ~/.local/bin with desktop file + icon (AppImage-friendly)."""
    import base64
    home = os.path.expanduser("~")
    bindir = os.path.join(home, ".local", "bin")
    appsdir = os.path.join(home, ".local", "share", "applications")
    iconsdir = os.path.join(home, ".local", "share", "icons", "hicolor", "256x256", "apps")
    for d in (bindir, appsdir, iconsdir):
        os.makedirs(d, exist_ok=True)

    # 1. copy self (works for AppImage, PyInstaller binary, or source script)
    dst = os.path.join(bindir, "tweakctl")
    try:
        shutil.copy2(sys.executable, dst)
        os.chmod(dst, 0o755)
    except Exception as e:
        die(f"Could not copy to {dst}: {e}")

    # 2. GUI wrapper script
    gui_wrapper = os.path.join(bindir, "tweakctl-gui")
    with open(gui_wrapper, "w") as f:
        f.write(f'#!/bin/sh\nexec "{dst}" gui\n')
    os.chmod(gui_wrapper, 0o755)

    # 3. desktop file
    with open(os.path.join(appsdir, "tweakctl-gui.desktop"), "w") as f:
        f.write(_desktop_content(bindir))

    # 4. icon — find it next to the script or in the PyInstaller bundle
    icon_src = None
    here = os.path.dirname(os.path.realpath(__file__))
    exe_dir = os.path.dirname(os.path.realpath(sys.executable))
    for cand in (os.path.join(here, "tweakctl.png"),
                 os.path.join(exe_dir, "tweakctl.png"),
                 os.path.join(getattr(sys, "_MEIPASS", ""), "tweakctl.png")):
        if cand and os.path.exists(cand):
            icon_src = cand
            break
    if icon_src:
        shutil.copy2(icon_src, os.path.join(iconsdir, "tweakctl.png"))
    else:
        print("  (icon not found — skipping)")

    # 5. refresh caches
    subprocess.run(["update-desktop-database", appsdir], capture_output=True)
    subprocess.run(["gtk-update-icon-cache", "-f", "-t", os.path.dirname(iconsdir)],
                   capture_output=True)

    print(f"Installed:")
    print(f"  CLI:     {dst}")
    print(f"  GUI:     {gui_wrapper}")
    print(f"  Desktop: {os.path.join(appsdir, 'tweakctl-gui.desktop')}")
    print(f"  Icon:    {os.path.join(iconsdir, 'tweakctl.png')}")
    print(f"\nLog out and back in (or run 'update-desktop-database {appsdir}')")
    print(f"to see Tweakctl in your apps menu.")


def uninstall():
    """Remove tweakctl from ~/.local/bin, applications, and icons."""
    home = os.path.expanduser("~")
    paths = [
        os.path.join(home, ".local", "bin", "tweakctl"),
        os.path.join(home, ".local", "bin", "tweakctl-gui"),
        os.path.join(home, ".local", "share", "applications", "tweakctl-gui.desktop"),
        os.path.join(home, ".local", "share", "icons", "hicolor", "256x256", "apps", "tweakctl.png"),
    ]
    removed = []
    for p in paths:
        if os.path.exists(p):
            os.remove(p)
            removed.append(p)
    if removed:
        print("Removed:")
        for p in removed:
            print(f"  {p}")
    else:
        print("tweakctl is not installed.")


def main():
    ex = """examples:
  tweakctl                       interactive menu (the easy way)
  tweakctl hibernate check       is hibernation working on this machine?
  tweakctl hibernate enable      set up hibernation (needs root)
  tweakctl s3 check              is deep (S3) sleep available / active?
  tweakctl plymouth check        is a boot splash configured?
  tweakctl plymouth preview      watch the boot animation (--theme NAME to try one)
  tweakctl sound list            list the bundled ctOS sounds
  tweakctl gui                   launch the graphical interface (needs tkinter)
  tweakctl update-check          check GitHub for a new release

DISCLAIMER: tweakctl rewrites GRUB / initramfs / systemd config at your own
risk. NO WARRANTY — you are responsible for your laptop. Back up your data,
keep a recovery USB ready, and if you dual-boot Windows, turn OFF Fast
Startup in Windows first. Full text:  tweakctl disclaimer"""
    p = argparse.ArgumentParser(
        prog="tweakctl",
        description="Set up hibernation, deep (S3) sleep, the boot splash (Plymouth) "
                    "and ctOS startup sounds on Linux (Arch, Ubuntu/Debian, "
                    "Fedora/RHEL) — interactively or from the shell.",
        epilog=ex,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version=VERSION)
    p.add_argument("--install", action="store_true", help="install tweakctl to ~/.local/bin with desktop file + icon")
    p.add_argument("--uninstall", action="store_true", help="remove tweakctl from ~/.local")
    sub = p.add_subparsers(dest="command")
    hib = sub.add_parser("hibernate", help="hibernation: check if it works / set it up")
    hib.add_argument("action", choices=["check","enable"])
    s3 = sub.add_parser("s3", help="deep (S3) sleep: check mode / set mode")
    s3.add_argument("action", choices=["check","enable","set-deep","set-s2idle"])
    pl = sub.add_parser("plymouth", help="boot splash: check / change theme / preview")
    pl.add_argument("action", choices=["check","apply","preview"]); pl.add_argument("--theme")
    so = sub.add_parser("sound", help="ctOS sounds: list / set startup sound / listen")
    so.add_argument("action", choices=["list","apply","preview"]); so.add_argument("--name"); so.add_argument("--volume", default="0.7")
    sub.add_parser("update-check", help="check GitHub for a new tweakctl release")
    sub.add_parser("disclaimer", help="print the risk disclaimer (read this first)")
    sub.add_parser("tui", help="interactive menu")
    sub.add_parser("gui", help="launch the graphical interface (needs tkinter)")
    a = p.parse_args()
    if a.install:
        install()
        return
    if a.uninstall:
        uninstall()
        return
    if a.command is None:
        if sys.stdin.isatty() and sys.stdout.isatty():
            tui()
        else:
            p.print_help()
            print("\n(no TTY detected — showing help instead of the interactive UI)")
        return
    if a.command == "tui":
        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            die("`tweakctl tui` needs an interactive terminal.")
        tui()
        return
    if a.command == "gui":
        import subprocess as _sp
        here = os.path.dirname(os.path.realpath(__file__))
        exe_dir = os.path.dirname(os.path.realpath(sys.executable))
        gui = None
        for cand in (os.path.join(here, "tweakctl-gui"),
                     os.path.join(exe_dir, "tweakctl-gui"),
                     shutil.which("tweakctl-gui")):
            if cand and os.path.exists(cand):
                gui = cand
                break
        if not gui:
            die("tweakctl-gui not found next to tweakctl — reinstall.")
        if os.access(gui, os.X_OK):
            _sp.call([gui])
        else:                       # e.g. copied without the exec bit
            _sp.call([sys.executable, gui])
        return
    if a.command == "hibernate":
        hibernate_check() if a.action=="check" else hibernate_enable()
    elif a.command == "s3":
        if a.action == "check": s3_check()
        elif a.action in ("enable","set-deep"): s3_set("deep")
        else: s3_set("s2idle")
    elif a.command == "plymouth":
        if a.action == "check":
            plymouth_check()
        elif a.action == "preview":
            plymouth_preview(a.theme)
        else:
            plymouth_apply(a.theme)
    elif a.command == "sound":
        if a.action == "list":
            sound_list()
        elif a.action == "preview":
            sound_preview(a.name)
        else:
            sound_apply(a.name or input("Sound name/path: "), a.volume)
    elif a.command == "update-check":
        update_check()
    elif a.command == "disclaimer":
        print(f"tweakctl disclaimer — read before using this tool\n{'=' * 54}")
        for para in disclaimer_paragraphs():
            print(f"\n{para}")
        print()
    else:
        p.print_help()

if __name__ == "__main__":
    main()
