# Maintainer: kingsuk-panda <kingsuk.panda.2004@gmail.com>
pkgname=tweakctl
pkgver=0.7.0
pkgrel=1
pkgdesc="Hibernation/S3/Plymouth/ctOS tuner CLI+GUI for Arch, Ubuntu, Fedora"
arch=('any')
url="https://github.com/kingsuk-panda/linux-hibernate-dual-boot-tweaks"
license=('MIT')
depends=('python' 'tk')
source=("$pkgname-$pkgver::https://raw.githubusercontent.com/kingsuk-panda/linux-hibernate-dual-boot-tweaks/v0.7.0/tweakctl/tweakctl"
        "$pkgname-gui-$pkgver::https://raw.githubusercontent.com/kingsuk-panda/linux-hibernate-dual-boot-tweaks/v0.7.0/tweakctl/tweakctl-gui")
sha256sums=('SKIP' 'SKIP')

package() {
  install -Dm755 "$srcdir/tweakctl-0.7.0" "$pkgdir/usr/local/bin/tweakctl"
  install -Dm755 "$srcdir/tweakctl-gui-0.7.0" "$pkgdir/usr/local/bin/tweakctl-gui"
  install -Dm644 "$srcdir/tweakctl-gui.desktop" \
    "$pkgdir/usr/share/applications/tweakctl-gui.desktop"
}
