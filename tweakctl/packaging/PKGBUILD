# Maintainer: kingsuk-panda <kingsuk.panda.2004@gmail.com>
pkgname=tweakctl
pkgver=0.8.0
pkgrel=1
pkgdesc="Hibernation/S3/Plymouth/ctOS tuner CLI+GUI for Arch, Ubuntu, Fedora"
arch=('any')
url="https://github.com/kingsuk-panda/linux-hibernate-dual-boot-tweaks"
license=('MIT')
depends=('python' 'tk')
source=("$pkgname-$pkgver::https://raw.githubusercontent.com/kingsuk-panda/linux-hibernate-dual-boot-tweaks/v${pkgver}/tweakctl/tweakctl"
        "$pkgname-gui-$pkgver::https://raw.githubusercontent.com/kingsuk-panda/linux-hibernate-dual-boot-tweaks/v${pkgver}/tweakctl/tweakctl-gui"
        "tweakctl-gui.desktop::https://raw.githubusercontent.com/kingsuk-panda/linux-hibernate-dual-boot-tweaks/v${pkgver}/tweakctl/tweakctl-gui.desktop"
        "tweakctl.png::https://raw.githubusercontent.com/kingsuk-panda/linux-hibernate-dual-boot-tweaks/v${pkgver}/tweakctl/tweakctl.png")
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 "$srcdir/tweakctl-$pkgver" "$pkgdir/usr/local/bin/tweakctl"
  install -Dm755 "$srcdir/tweakctl-gui-$pkgver" "$pkgdir/usr/local/bin/tweakctl-gui"
  install -Dm644 "$srcdir/tweakctl-gui.desktop" \
    "$pkgdir/usr/share/applications/tweakctl-gui.desktop"
  install -Dm644 "$srcdir/tweakctl.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/tweakctl.png"
}
