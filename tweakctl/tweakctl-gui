#!/usr/bin/env python3
"""tweakctl-gui — graphical front-end for tweakctl (hibernation, S3, Plymouth, sounds).

Works on any distro with python3 + tkinter. Reuses the tweakctl CLI for all
system changes (elevated via pkexec/sudo) and its state functions for checks.
"""
import argparse, importlib.util, importlib.machinery, os, queue, re, shutil, subprocess, sys, threading, time

VERSION = "0.7.1"
GH_REPO = "kingsuk-panda/linux-hibernate-dual-boot-tweaks"

# ---------- import the tweakctl module (file has no .py extension) ----------
def load_tweakctl():
    here = os.path.dirname(os.path.realpath(__file__))
    path = shutil.which("tweakctl") or os.path.join(here, "tweakctl")
    if not os.path.exists(path):
        die(f"tweakctl CLI not found (looked in PATH and {here}).")
    spec = importlib.util.spec_from_loader("tweakctl",
        importlib.machinery.SourceFileLoader("tweakctl", path))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod, path

def die(msg):
    print(f"tweakctl-gui: {msg}", file=sys.stderr)
    sys.exit(1)

try:
    import tkinter as tk
    from tkinter import ttk, messagebox, simpledialog
except ImportError:
    die("tkinter is missing. Install it for your distro:\n"
        "  Arch/Manjaro : sudo pacman -S tk\n"
        "  Debian/Ubuntu: sudo apt install python3-tk\n"
        "  Fedora/RHEL  : sudo dnf install python3-tkinter")

TC, TWEAKCTL_PATH = load_tweakctl()

# ---------- colors ----------
GREEN, RED, YELLOW, BLUE, GREY = "#2ecc71", "#e74c3c", "#f1c40f", "#3498db", "#7f8c8d"
BG, FG, PANEL = "#1e1e2e", "#e0e0e0", "#2a2a3a"
DARK, LIGHT, ACCENT = "#111118", "#a0ffa0", "#8b5cf6"

ANSI = re.compile(r"\x1b\[[0-9;]*m")
def strip(s): return ANSI.sub("", s)

# ---------- elevation ----------
_elev = {"prefix": None, "password": None}

def elevate_prefix():
    """Command prefix to run something as root, or None if already root."""
    if _elev["prefix"] is not None:
        return _elev["prefix"]
    if os.geteuid() == 0:
        _elev["prefix"] = []
    elif subprocess.run(["sudo", "-n", "true"], capture_output=True).returncode == 0:
        _elev["prefix"] = ["sudo", "-n"]
    elif shutil.which("pkexec"):
        _elev["prefix"] = ["pkexec"]
    else:
        pw = simpledialog.askstring("Password needed",
                                       "Enter your sudo password (kept in memory only):",
                                       show="*")
        if not pw:
            die("No password — cannot perform system changes.")
        p = subprocess.run(["sudo", "-S", "-v"], input=pw + "\n",
                           capture_output=True, text=True)
        if p.returncode != 0:
            die("sudo password rejected.")
        _elev["prefix"] = ["sudo", "-n"]
        _elev["password"] = pw
    return _elev["prefix"]

def run_cli(args, elevated=True, timeout=300):
    """Run tweakctl as a subprocess; returns (rc, combined_output)."""
    cmd = (elevate_prefix() if elevated else []) + [TWEAKCTL_PATH] + args
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, (p.stdout or "") + (p.stderr or "")
    except subprocess.TimeoutExpired:
        return 124, "Timed out."

# ---------- worker thread ----------
class Worker:
    def __init__(self, app):
        self.app = app
        self.q = queue.Queue()
        self.busy = False
        self.preview_proc = None

    def start(self, fn, *args):
        if self.busy:
            return
        self.busy = True
        self.app.set_buttons_state("disabled")
        def wrap():
            try:
                fn(*args)
            except Exception as e:
                self.q.put(("log", f"[FAIL] error: {e}"))
            self.q.put(("done",))
        threading.Thread(target=wrap, daemon=True).start()

    def poll(self):
        try:
            while True:
                kind, *rest = self.q.get_nowait()
                if kind == "log":
                    self.app.log(rest[0])
                elif kind == "done":
                    self.busy = False
                    self.app.set_buttons_state("normal")
                    self.app.refresh()
        except queue.Empty:
            pass
        self.app.after(100, self.poll)

# ---------- dialogs ----------
class Dialog(tk.Toplevel):
    def __init__(self, app, title, width=560, height=420):
        super().__init__(app)
        self.app = app
        self.result = None
        self.title(title)
        self.configure(bg=BG)
        self.transient(app)
        self.grab_set()
        self.geometry(f"{width}x{height}+{app.winfo_x()+40}+{app.winfo_y()+40}")
        self.bind("<Escape>", lambda e: self.cancel())

    def cancel(self):
        self.result = False
        self.destroy()

    def finish(self, val=True):
        self.result = val
        self.destroy()

class Confirm(Dialog):
    """'Are you sure?' with explanation. Defaults to No."""
    def __init__(self, app, title, lines, yes="Yes, do it", no="Cancel"):
        super().__init__(app, title, 520, 120 + 26 * len(lines))
        fr = tk.Frame(self, bg=BG); fr.pack(fill="both", expand=True, padx=16, pady=14)
        for ln in lines:
            tk.Label(fr, text=ln, bg=BG, fg=FG, justify="left",
                     wraplength=480, font=("Segoe UI", 10)).pack(anchor="w", pady=2)
        row = tk.Frame(fr, bg=BG); row.pack(pady=(14, 0))
        tk.Button(row, text=no, command=self.cancel, width=12,
                  font=("Segoe UI", 10, "bold")).pack(side="right", padx=(8, 0))
        tk.Button(row, text=yes, command=lambda: self.finish(True), width=16,
                  bg=RED, fg="white", font=("Segoe UI", 10, "bold")).pack(side="right")

class Chooser(Dialog):
    """List picker with ↑/↓ + Enter, Esc cancels, • markers."""
    def __init__(self, app, title, items, marker_idx=None):
        super().__init__(app, title, 640, 460)
        self.items = items
        self.sel = marker_idx if marker_idx is not None else 0
        self.lb = tk.Listbox(self, bg=PANEL, fg=FG, selectbackground=BLUE,
                             font=("Consolas", 11), highlightthickness=0,
                             activestyle="none", exportselection=False)
        for i, (label, _) in enumerate(items):
            self.lb.insert("end", label)
        self.lb.pack(fill="both", expand=True, padx=12, pady=(12, 4))
        self.lb.select_set(self.sel)
        self.lb.see(self.sel)
        tk.Label(self, text="↑/↓ move   Enter select   Esc cancel",
                 bg=BG, fg=GREY, font=("Segoe UI", 9)).pack(pady=(0, 8))
        self.lb.bind("<Return>", lambda e: self._pick())
        self.lb.bind("<Double-Button-1>", lambda e: self._pick())
        self.lb.focus_set()
        self.after(50, self._loop)

    def _loop(self):
        cur = self.lb.curselection()
        if cur and cur[0] != self.sel:
            self.sel = cur[0]
        self.after(80, self._loop)

    def _pick(self):
        self.finish(self.items[self.sel][1])

class Disclaimer(Dialog):
    def __init__(self, app):
        paras = TC.disclaimer_paragraphs()
        super().__init__(app, "Read this first — important", 640, 150 + 30 * len(paras))
        fr = tk.Frame(self, bg=BG); fr.pack(fill="both", expand=True, padx=16, pady=12)
        for p in paras:
            tk.Label(fr, text="• " + p, bg=BG, fg=FG, justify="left",
                     wraplength=600, font=("Segoe UI", 9)).pack(anchor="w", pady=3)
        row = tk.Frame(fr, bg=BG); row.pack(pady=(12, 0))
        tk.Button(row, text="No, quit", command=self.cancel, width=12,
                  font=("Segoe UI", 10, "bold")).pack(side="right", padx=(8, 0))
        tk.Button(row, text="Yes, I accept", command=lambda: self.finish(True), width=16,
                  bg=GREEN, fg="white", font=("Segoe UI", 10, "bold")).pack(side="right")

# ---------- main app ----------
class App(tk.Tk):
    def __init__(self, selftest=False):
        super().__init__()
        self.title(f"tweakctl GUI  v{VERSION}")
        self.configure(bg=BG)
        self.geometry("960x640")
        self.worker = Worker(self)
        self.playing = None
        self._build()
        self.after(100, self.worker.poll)
        if selftest:
            self.after(300, self.selftest)
        else:
            self.protocol("WM_DELETE_WINDOW", self.on_close)
            if not TC.disclaimer_accepted():
                d = Disclaimer(self)
                self.wait_window(d)
                if d.result is not True:
                    self.destroy(); sys.exit(0)
                TC.save_disclaimer()
                self.log("Disclaimer accepted — saved.")
            self.refresh()

    # ----- UI construction -----
    def _build(self):
        top = tk.Frame(self, bg=BG); top.pack(fill="x", padx=10, pady=(8, 0))
        tk.Label(top, text=f"tweakctl GUI  v{VERSION}", bg=BG, fg=FG,
                 font=("Segoe UI", 14, "bold")).pack(side="left")
        self.status = tk.Label(top, text="●", bg=BG, fg=GREY,
                               font=("Segoe UI", 14))
        self.status.pack(side="right")

        body = tk.Frame(self, bg=BG); body.pack(fill="both", expand=True, padx=10, pady=8)
        nav = tk.Frame(body, bg=PANEL); nav.pack(side="left", fill="y")
        self.pages = {}
        self.navbtns = []
        for key, label in [("dash", "Dashboard"), ("hib", "Hibernation"),
                           ("s3", "Sleep (S3)"), ("ply", "Boot splash"),
                           ("snd", "Sounds"), ("upd", "Updates"),
                           ("abt", "About")]:
            b = tk.Button(nav, text=label, width=16, bg=PANEL, fg=FG,
                          relief="flat", font=("Segoe UI", 10),
                          command=lambda k=key: self.show(k))
            b.pack(fill="x", pady=1)
            self.navbtns.append((key, b))
        self.content = tk.Frame(body, bg=BG)
        self.content.pack(side="left", fill="both", expand=True, padx=(8, 0))

        self.logbox = tk.Text(self, height=7, bg=DARK, fg=LIGHT,
                              font=("Consolas", 9), state="disabled",
                              relief="flat")
        self.logbox.pack(fill="x", padx=10, pady=(0, 8))
        self.logbox.tag_config("ok", foreground=GREEN)
        self.logbox.tag_config("fail", foreground=RED)
        self.logbox.tag_config("warn", foreground=YELLOW)
        self.logbox.tag_config("info", foreground=GREY)

    def set_buttons_state(self, st):
        for _, b in self.navbtns:
            b.config(state=st)

    def show(self, key):
        for k, b in self.navbtns:
            b.config(bg=BLUE if k == key else PANEL)
        for w in self.content.winfo_children():
            w.destroy()
        page_fn = getattr(self, f"page_{key}")
        page_fn(self.content)
        self.current = key

    def log(self, text):
        self.logbox.config(state="normal")
        for line in strip(text).splitlines() or [""]:
            tag = "info"
            if "[OK]" in line or ">>>" in line: tag = "ok"
            elif "[FAIL]" in line or "NOT" in line: tag = "fail"
            elif "[WARN]" in line: tag = "warn"
            self.logbox.insert("end", line + "\n", tag)
        self.logbox.see("end")
        self.logbox.config(state="disabled")

    # ----- shared status helpers -----
    def status_line(self, parent, ok, okmsg, failmsg):
        color, msg = (GREEN, okmsg) if ok else (RED, failmsg)
        tk.Label(parent, text="●", bg=BG, fg=color,
                 font=("Segoe UI", 16, "bold")).pack(anchor="w")
        tk.Label(parent, text=msg, bg=BG, fg=color, font=("Segoe UI", 12, "bold"),
                 wraplength=700, justify="left").pack(anchor="w", pady=(0, 8))

    def bullet(self, parent, level, msg):
        colors = {"ok": GREEN, "fail": RED, "warn": YELLOW, "info": FG}
        tk.Label(parent, text="• " + msg, bg=BG, fg=colors.get(level, FG),
                 font=("Segoe UI", 10), wraplength=700,
                 justify="left").pack(anchor="w")

    def button_row(self, parent, buttons):
        row = tk.Frame(parent, bg=BG)
        row.pack(fill="x", pady=(10, 0))
        for btn in buttons:
            label, cmd = btn[0], btn[1]
            kw = btn[2] if len(btn) > 2 else {}
            tk.Button(row, text=label, command=cmd, width=20, height=1,
                      font=("Segoe UI", 10, "bold"), **kw).pack(side="left", padx=(0, 8))
        return row

    def windows_banner(self, parent):
        if TC.windows_present():
            tk.Label(parent, text="⚠ Windows dual-boot detected — turn OFF 'Fast Startup' "
                                  "in Windows before testing hibernation.",
                     bg=BG, fg=YELLOW, font=("Segoe UI", 10, "bold"),
                     wraplength=700, justify="left").pack(anchor="w", pady=(4, 0))

    # ----- pages -----
    def page_dash(self, parent):
        ready, items = TC.hibernation_state()
        deep, active, persists = TC.s3_state()
        ply = os.path.exists("/usr/share/plymouth") or shutil.which("plymouth")
        cur_ply = TC.current_plymouth_theme()
        snd = TC.sound_choices()
        cur_snd = TC.current_boot_sound()

        self.status_line(parent, ready,
                         "HIBERNATION IS READY" if ready else "HIBERNATION IS NOT SET UP",
                         "Hibernation: not ready yet")
        self.button_row(parent, [("Set up hibernation", lambda: self.act_hib()),
                                  ("Refresh", self.refresh)])
        self.windows_banner(parent)
        tk.Frame(parent, bg=PANEL, height=1).pack(fill="x", pady=8)

        self.status_line(parent, active,
                         "S3 DEEP SLEEP IS ACTIVE" if active else "S3 deep sleep is NOT active",
                         "S3 deep sleep: not active")
        self.button_row(parent, [("Use deep sleep (S3)", lambda: self.act_s3("deep")),
                                  ("Use s2idle", lambda: self.act_s3("s2idle"))])
        tk.Frame(parent, bg=PANEL, height=1).pack(fill="x", pady=8)

        self.status_line(parent, bool(ply),
                         f"Plymouth installed — theme: {cur_ply or 'default'}" if ply
                         else "Plymouth is NOT installed",
                         "Plymouth: not installed")
        self.button_row(parent, [("Change boot splash", lambda: self.show("ply")),
                                  ("Preview animation", lambda: self.act_preview(cur_ply))])
        tk.Frame(parent, bg=PANEL, height=1).pack(fill="x", pady=8)

        self.status_line(parent, bool(snd),
                         f"{len(snd)} sound(s) found" + (f" — current: {os.path.basename(cur_snd)}" if cur_snd else "")
                         if snd else "No sounds found",
                         "Sounds: none found")
        self.button_row(parent, [("Sounds & startup sound", lambda: self.show("snd"))])

    def page_hib(self, parent):
        ready, items = TC.hibernation_state()
        self.status_line(parent, ready,
                         "HIBERNATION IS ALREADY IMPLEMENTED" if ready
                         else "HIBERNATION IS NOT SUPPORTED / NOT SET UP",
                         "Hibernation is ready" if ready else "Hibernation is not ready")
        for level, msg in items:
            self.bullet(parent, level, msg)
        self.windows_banner(parent)
        if ready:
            self.button_row(parent, [("Re-apply anyway", lambda: self.act_hib(force=True))])
        else:
            self.button_row(parent, [("Set up hibernation", lambda: self.act_hib())])

    def page_s3(self, parent):
        deep, active, persists = TC.s3_state()
        mode = TC.s3_active_mode()
        self.status_line(parent, active,
                         "S3 DEEP SLEEP IS ACTIVE" if active else "S3 DEEP SLEEP IS NOT ACTIVE",
                         f"S3 deep sleep is active (current mode: {mode})" if active
                         else f"S3 deep sleep is not active (current mode: {mode})")
        self.bullet(parent, "ok" if deep else "fail",
                    "Hardware supports S3 (deep) sleep." if deep
                    else "Hardware does NOT support S3 (deep) sleep.")
        self.bullet(parent, "ok" if persists else "warn",
                    "mem_sleep_default=deep persists across reboots." if persists
                    else "mem_sleep_default=deep is NOT on the kernel cmdline.")
        self.button_row(parent, [("Use deep sleep (S3)", lambda: self.act_s3("deep")),
                                  ("Use s2idle (shallow)", lambda: self.act_s3("s2idle"))])

    def page_ply(self, parent):
        cur = TC.current_plymouth_theme()
        self.status_line(parent, True, f"Current boot splash theme: {cur or 'default'}",
                         "Plymouth is not installed")
        themes = TC.installed_plymouth_themes()
        if not themes:
            self.bullet(parent, "fail", "No Plymouth themes installed.")
            return
        idx = themes.index(cur) if cur in themes else 0
        def choose():
            c = Chooser(self, "Select boot splash theme",
                        [(f"{t}  • current" if t == cur else t, t) for t in themes], idx)
            self.wait_window(c)
            if c.result:
                self.act_apply(c.result)
        self.button_row(parent, [("Change theme", choose),
                                  ("Preview current", lambda: self.act_preview(cur))])

    def page_snd(self, parent):
        cur = TC.current_boot_sound()
        choices = TC.sound_choices()
        if not choices:
            self.bullet(parent, "fail", "No sounds found. Install tweakctl sounds first.")
            return
        idx = next((i for i, (_, p) in enumerate(choices) if p == cur), 0)
        self.status_line(parent, True,
                         f"Startup sound: {os.path.basename(cur)}" if cur
                         else "No startup sound set",
                         "Sounds")
        def choose():
            c = Chooser(self, "Select a sound",
                        [(f"{l}  • current" if p == cur else l, p)
                         for l, p in choices], idx)
            self.wait_window(c)
            if c.result:
                self.preview(c.result)
        def choose_set():
            c = Chooser(self, "Set startup sound",
                        [(f"{l}  • current" if p == cur else l, p)
                         for l, p in choices], idx)
            self.wait_window(c)
            if c.result:
                self.act_sound(c.result)
        self.button_row(parent, [("Play a sound", choose),
                                  ("Set startup sound", choose_set)])
        if self.playing:
            self.button_row(parent, [("■ Stop playback", self.stop_sound)])

    def page_upd(self, parent):
        self.status_line(parent, True, f"tweakctl version {TC.VERSION}", "Updates")
        self.button_row(parent, [("Check for updates", self.act_update)])
        self._upd_result = tk.Label(parent, text="", bg=BG, fg=FG,
                                    font=("Segoe UI", 10), wraplength=700,
                                    justify="left")
        self._upd_result.pack(anchor="w", pady=8)

    def page_abt(self, parent):
        tk.Label(parent, text=f"tweakctl GUI  v{VERSION}", bg=BG, fg=FG,
                 font=("Segoe UI", 14, "bold")).pack(anchor="w")
        tk.Label(parent, text=f"CLI version: {TC.VERSION}", bg=BG, fg=GREY,
                 font=("Segoe UI", 10)).pack(anchor="w", pady=(2, 8))
        tk.Label(parent, text="Set up hibernation, S3 deep sleep, Plymouth boot splash "
                              "and ctOS sounds on Arch, Ubuntu/Debian and Fedora/RHEL.",
                 bg=BG, fg=FG, font=("Segoe UI", 10), wraplength=700,
                 justify="left").pack(anchor="w")
        tk.Label(parent, text=f"https://github.com/{GH_REPO}", bg=BG, fg=BLUE,
                 font=("Segoe UI", 10, "underline"), cursor="hand2").pack(anchor="w", pady=(6, 0))
        acc = TC.disclaimer_status()
        tk.Label(parent, text=f"Disclaimer: {'accepted ' + acc if acc else 'NOT accepted'}",
                 bg=BG, fg=(GREEN if acc else YELLOW),
                 font=("Segoe UI", 10, "bold")).pack(anchor="w", pady=(10, 0))
        self.button_row(parent, [("Read the disclaimer", self.act_disclaimer),
                                  ("Open repo in browser",
                                   lambda: subprocess.Popen(["xdg-open", f"https://github.com/{GH_REPO}"],
                                                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))])

    # ----- actions -----
    def refresh(self):
        self.show(getattr(self, "current", "dash"))

    def act_hib(self, force=False):
        def go():
            if not force and TC.hibernation_ready():
                self.q_confirm([
                    "Hibernation is already implemented on this machine.",
                    "Re-applying will rewrite GRUB / initramfs / fstab again.",
                    "Only continue if you know what you are doing."])
                return
            self.log(">> Setting up hibernation (needs root)...")
            rc, out = run_cli(["hibernate", "enable"])
            self.log(out)
            if rc == 0:
                self.log("[OK] Done — reboot, then test with: systemctl hibernate")
        self.worker.start(go)

    def q_confirm(self, lines):
        """Confirm from the worker thread; blocks it until answered."""
        box = {}
        def ask():
            d = Confirm(self, "Are you sure?", lines)
            self.wait_window(d)
            box["r"] = d.result
        self.after(0, ask)
        while "r" not in box:
            time.sleep(0.05)
        if box["r"] is not True:
            self.log("[INFO] Cancelled — nothing was changed.")

    def act_s3(self, mode):
        def go():
            _, active, _ = TC.s3_state()
            if mode == "deep" and active:
                self.q_confirm(["S3 deep sleep is already the active mode.",
                                "Re-applying will rewrite the kernel cmdline again."])
                return
            self.log(f">> Setting suspend mode to {mode} (needs root)...")
            rc, out = run_cli(["s3", "set-deep" if mode == "deep" else "set-s2idle"])
            self.log(out)
        self.worker.start(go)

    def act_apply(self, theme):
        def go():
            self.log(f">> Setting boot splash theme to '{theme}' (needs root)...")
            rc, out = run_cli(["plymouth", "apply", "--theme", theme])
            self.log(out)
        self.worker.start(go)

    def act_preview(self, theme):
        """Preview Plymouth theme. ESC or Close stops the preview."""
        def go():
            self.log(f">> Previewing boot splash '{theme}' — watch your screen (needs root)...")
            self.log(">> Press ESC or Close to stop the preview.")
            # Run preview in a thread so we can kill it on ESC
            self._preview_stop = threading.Event()
            def run():
                try:
                    prefix = elevate_prefix()
                    cmd = prefix + [TWEAKCTL_PATH, "plymouth", "preview", "--theme", theme]
                    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                         text=True)
                    self.worker.preview_proc = p
                    while True:
                        line = p.stdout.readline()
                        if not line and p.poll() is not None:
                            break
                        if line:
                            self.q.put(("log", line.rstrip()))
                        if self._preview_stop.is_set():
                            p.terminate()
                            try:
                                p.wait(timeout=5)
                            except subprocess.TimeoutExpired:
                                p.kill()
                            self.q.put(("log", "[INFO] Preview stopped by ESC."))
                            break
                except Exception as e:
                    self.q.put(("log", f"[FAIL] preview error: {e}"))
            threading.Thread(target=run, daemon=True).start()
        self.worker.start(go)

    def stop_preview(self):
        """Stop the running Plymouth preview (called from ESC or Close button)."""
        if hasattr(self, "_preview_stop"):
            self._preview_stop.set()
        if self.worker.preview_proc:
            try:
                self.worker.preview_proc.terminate()
                self.worker.preview_proc.wait(timeout=5)
            except Exception:
                try:
                    self.worker.preview_proc.kill()
                except Exception:
                    pass
            self.worker.preview_proc = None
        self.log("[INFO] Preview stopped.")

    def preview(self, path):
        def go():
            self.log(f">> Playing {os.path.basename(path)}...")
            rc, out = run_cli(["sound", "preview", "--name", path], elevated=False, timeout=60)
            self.log(out)
        self.worker.start(go)

    def stop_sound(self):
        if self.playing:
            self.playing.terminate()
            self.playing = None
            self.log("[INFO] Playback stopped.")

    def act_sound(self, path):
        def go():
            self.log(f">> Setting startup sound to {os.path.basename(path)}...")
            rc, out = run_cli(["sound", "apply", "--name", path], elevated=False)
            self.log(out)
        self.worker.start(go)

    def act_update(self):
        def go():
            self.log(">> Checking for updates...")
            rc, out = run_cli(["update-check"], elevated=False, timeout=30)
            self.log(out)
            if hasattr(self, "_upd_result"):
                self._upd_result.config(text=strip(out))
        self.worker.start(go)

    def act_disclaimer(self):
        d = Disclaimer(self)
        self.wait_window(d)
        if d.result is True:
            TC.save_disclaimer()
            self.log("Disclaimer accepted — saved.")

    def on_close(self):
        self.stop_preview()
        if self.playing:
            self.playing.terminate()
        self.destroy()

    # ----- self test -----
    def selftest(self):
        import io, contextlib
        checks = []
        def ck(name, cond):
            checks.append((name, bool(cond)))
            print(("PASS " if cond else "FAIL ") + name)
        try:
            ck("disclaimer accepted", TC.disclaimer_accepted())
            ready, items = TC.hibernation_state()
            ck("hibernation_state returns items", isinstance(items, list) and len(items) > 3)
            ck("s3_state returns 3-tuple", len(TC.s3_state()) == 3)
            ck("sound_choices returns list", isinstance(TC.sound_choices(), list))
            ck("current_plymouth_theme", isinstance(TC.current_plymouth_theme(), (str, type(None))))
            ck("windows_present", TC.windows_present() in (True, False))
            # navigation
            for key in ["dash", "hib", "s3", "ply", "snd", "upd", "abt"]:
                self.show(key)
                self.update()
                ck(f"page {key} renders", len(self.content.winfo_children()) > 0)
            # chooser dialog
            self.show("snd")
            c = Chooser(self, "t", [("a", "x"), ("b  • current", "y")], 1)
            self.update()
            ck("chooser lists items", c.lb.size() == 2)
            c._pick()
            ck("chooser picks", c.result == "y")
            # confirm dialog defaults to No
            cf = Confirm(self, "t", ["line1", "line2"])
            self.update()
            cf.cancel()
            ck("confirm cancel", cf.result is False)
            # disclaimer dialog builds
            d = Disclaimer(self)
            self.update()
            ck("disclaimer builds", d.result is None)
            d.cancel()
            # log with ANSI strip
            self.log("\x1b[92m[OK]\x1b[0m green line")
            self.update()
            flat = self.logbox.get("1.0", "end")
            ck("ansi stripped", "\x1b" not in flat and "[OK]" in flat)
            # cli path resolution
            ck("cli path found", os.path.exists(TWEAKCTL_PATH))
            # esc handling - preview stop
            self._preview_stop = threading.Event()
            ck("preview stop event exists", hasattr(self, "_preview_stop"))
            self.stop_preview()
            ck("stop_preview callable", True)
        except Exception as e:
            import traceback; traceback.print_exc()
            ck(f"exception: {e}", False)
        ok = all(c for _, c in checks)
        print(f"\n{sum(c for _, c in checks)}/{len(checks)} checks passed")
        self.destroy()
        sys.exit(0 if ok else 1)

def main():
    p = argparse.ArgumentParser(prog="tweakctl-gui",
        description="Graphical front-end for tweakctl — hibernation, S3, Plymouth, sounds.")
    p.add_argument("--version", action="version", version=VERSION)
    p.add_argument("--selftest", action="store_true",
                   help="run headless self-test and exit")
    a = p.parse_args()
    App(selftest=a.selftest).mainloop()

if __name__ == "__main__":
    main()
