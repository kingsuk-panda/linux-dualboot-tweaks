#!/usr/bin/env python3
"""tweakctl-gui — modern graphical front-end for tweakctl.

Dark, flat, card-based UI with an icon sidebar, status pills,
rounded buttons, toast notifications and an in-app Plymouth
animation player. Works on any distro with python3 + tkinter.
Reuses the tweakctl CLI for all system changes (elevated via
pkexec/sudo) and its state functions for checks.
"""
import argparse, importlib.util, importlib.machinery, os, queue, re, shutil, subprocess, sys, threading, time

VERSION = "0.8.0"
