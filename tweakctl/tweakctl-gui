# ---------- pure-Python GIF decoder (no PIL needed) ----------
def _lzw(raw, min_code_size):
    """GIF LZW decompression -> bytes of palette indices."""
    clear = 1 << min_code_size
    end = clear + 1
    codes = {i: bytes([i]) for i in range(clear)}
    code_size = min_code_size + 1
    next_code = end + 1
    out = bytearray()
    prev = None
    bits = nbits = pos = 0

    def read_code(size):
        nonlocal bits, nbits, pos
        while nbits < size:
            if pos >= len(raw):
                raise EOFError
            bits |= raw[pos] << nbits
            pos += 1
            nbits += 8
        c = bits & ((1 << size) - 1)
        bits >>= size
        nbits -= size
        return c

    while True:
        try:
            code = read_code(code_size)
        except EOFError:
            break
        if code == clear:
            codes = {i: bytes([i]) for i in range(clear)}
            code_size = min_code_size + 1
            next_code = end + 1
            prev = None
            continue
        if code == end:
            break
        if code in codes:
            entry = codes[code]
        elif code == next_code and prev is not None:
            entry = prev + prev[:1]
        else:
            break
        out += entry
        if prev is not None and next_code < 4096:
            codes[next_code] = prev + entry[:1]
            next_code += 1
            if next_code >= (1 << code_size) and code_size < 12:
                code_size += 1
        prev = entry
    return bytes(out)

def _deinterlace(rows, w, h):
    out = bytearray(w * h)
    src = 0
    for start, step in ((0, 8), (4, 8), (2, 4), (1, 2)):
        for y in range(start, h, step):
            out[y * w:(y + 1) * w] = rows[src * w:(src + 1) * w]
            src += 1
    return bytes(out)

def _pal_list(pal):
    out = [b"\x00\x00\x00"] * 256
    for i, c in enumerate(pal):
        if i >= 256:
            break
        out[i] = bytes(c)
    return out

def gif_frames(path):
    """Yield (ppm_p6_bytes, delay_ms) — every composited frame of a GIF,
    ready for tk.PhotoImage(data=ppm, format='ppm')."""
    with open(path, "rb") as f:
        data = f.read()
    if data[:6] not in (b"GIF87a", b"GIF89a"):
        raise ValueError("not a GIF")
    pos = 6
    sw = int.from_bytes(data[pos:pos + 2], "little"); pos += 2
    sh = int.from_bytes(data[pos:pos + 2], "little"); pos += 2
    packed = data[pos]; pos += 3
    gct = []
    if packed & 0x80:
        n = 3 << ((packed & 0x07) + 1)
        gct = [tuple(data[pos + i:pos + i + 3]) for i in range(0, n, 3)]
        pos += n
    bg_idx = data[9] if len(data) > 9 else 0

    canvas = None
    snap = None
    prev_disposal = 0
    gce = {"delay": 10, "trans": -1, "disposal": 0}
    header = b"P6\n%d %d\n255\n" % (sw, sh)

    while pos < len(data):
        b = data[pos]; pos += 1
        if b == 0x3B:
            break
        if b == 0x21:
            label = data[pos]; pos += 1
            payload = b""
            while pos < len(data):
                n = data[pos]; pos += 1
                if n == 0:
                    break
                payload += data[pos:pos + n]; pos += n
            if label == 0xF9 and len(payload) >= 4:
                gce = {
                    "disposal": (payload[0] >> 2) & 0x07,
                    "delay": max(1, int.from_bytes(payload[1:3], "little")),
                    "trans": payload[3],
                }
            continue
        if b != 0x2C:
            continue
        left = int.from_bytes(data[pos:pos + 2], "little"); pos += 2
        top = int.from_bytes(data[pos:pos + 2], "little"); pos += 2
        w = int.from_bytes(data[pos:pos + 2], "little"); pos += 2
        h = int.from_bytes(data[pos:pos + 2], "little"); pos += 2
        ipacked = data[pos]; pos += 1
        lct = None
        if ipacked & 0x80:
            n = 3 << ((ipacked & 0x07) + 1)
            lct = [tuple(data[pos + i:pos + i + 3]) for i in range(0, n, 3)]
            pos += n
        interlace = bool(ipacked & 0x40)
        min_code_size = data[pos]; pos += 1
        raw = bytearray()
        while pos < len(data):
            n = data[pos]; pos += 1
            if n == 0:
                break
            raw += data[pos:pos + n]; pos += n
        indices = _lzw(bytes(raw), min_code_size)
        if interlace:
            indices = _deinterlace(indices, w, h)

        pal = lct if lct is not None else gct
        pal_list = _pal_list(pal)
        if canvas is None:
            canvas = bytearray([bg_idx]) * (sw * sh)
        if prev_disposal == 2:
            canvas = bytearray([bg_idx]) * (sw * sh)
        elif prev_disposal == 3 and snap is not None:
            canvas = bytearray(snap)
        snap = bytearray(canvas)
        trans = gce["trans"]
        if (trans < 0 and left == 0 and top == 0
                and w == sw and h == sh and not interlace):
            canvas = bytearray(indices)
        else:
            for y in range(h):
                base = (top + y) * sw + left
                row = indices[y * w:(y + 1) * w]
                for x in range(w):
                    if row[x] != trans:
                        canvas[base + x] = row[x]
        rgb = b"".join(map(pal_list.__getitem__, canvas))
        yield header + rgb, max(20, gce["delay"] * 10)

# ---------- elevation ----------
_elev = {"prefix": None, "password": None}

def elevate_prefix():
    """Command prefix to run something as root, or None if already root."""
    if _elev["prefix"] is not None:
        return _elev["prefix"]
    if os.geteuid() == 0:
        _elev["prefix"] = []
    elif subprocess.run(["sudo", "-n", "true"], capture_output=True).returncode == 0:
        _elev["prefix"] = ["sudo", "-n"]
    elif shutil.which("pkexec"):
        _elev["prefix"] = ["pkexec"]
    else:
        pw = simpledialog.askstring("Password needed",
                                       "Enter your sudo password (kept in memory only):",
                                       show="*")
        if not pw:
            die("No password — cannot perform system changes.")
        p = subprocess.run(["sudo", "-S", "-v"], input=pw + "\n",
                           capture_output=True, text=True)
        if p.returncode != 0:
            die("sudo password rejected.")
        _elev["prefix"] = ["sudo", "-n"]
        _elev["password"] = pw
    return _elev["prefix"]

def run_cli(args, elevated=True, timeout=300):
    """Run tweakctl as a subprocess; returns (rc, combined_output)."""
    cmd = (elevate_prefix() if elevated else []) + [TWEAKCTL_PATH] + args
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, (p.stdout or "") + (p.stderr or "")
    except subprocess.TimeoutExpired:
        return 124, "Timed out."

# ---------- worker thread ----------
class Worker:
    def __init__(self, app):
        self.app = app
        self.q = queue.Queue()
        self.busy = False
        self.preview_proc = None

    def start(self, fn, *args):
        if self.busy:
            return
        self.busy = True
        self.app.set_busy(True)
        self.app.set_buttons_state("disabled")
        def wrap():
            try:
                fn(*args)
            except Exception as e:
                self.q.put(("log", f"[FAIL] error: {e}"))
            self.q.put(("done",))
        threading.Thread(target=wrap, daemon=True).start()

    def poll(self):
        try:
            while True:
                kind, *rest = self.q.get_nowait()
                if kind == "log":
                    self.app.log(rest[0])
                elif kind == "done":
                    self.busy = False
                    self.app.set_busy(False)
                    self.app.set_buttons_state("normal")
                    self.app.refresh()
        except queue.Empty:
            pass
        self.app.after(100, self.poll)

# ---------- widgets ----------
def _rounded(canvas, x1, y1, x2, y2, r, fill):
    """Fill a rounded rectangle on a canvas (arcs + rects, no border)."""
    canvas.create_rectangle(x1 + r, y1, x2 - r, y2, fill=fill, outline="")
    canvas.create_rectangle(x1, y1 + r, x2, y2 - r, fill=fill, outline="")
    for cx, cy in ((x1 + r, y1 + r), (x2 - r, y1 + r),
                   (x1 + r, y2 - r), (x2 - r, y2 - r)):
        canvas.create_oval(cx - r, cy - r, cx + r, cy + r,
                           fill=fill, outline="")

class RButton(tk.Canvas):
    """Flat rounded button with hover + press feedback."""
    def __init__(self, parent, text, command=None, accent=False,
                 width=170, height=34, bg=None):
        self.bg = bg if bg is not None else parent["bg"]
        super().__init__(parent, width=width, height=height,
                         highlightthickness=0, bg=self.bg, takefocus=True)
        self.text = text
        self.command = command
        self.accent = accent
        self._hover = False
        self._down = False
        self.bind("<Enter>", lambda e: self._hover_changed(True))
        self.bind("<Leave>", lambda e: self._hover_changed(False))
        self.bind("<ButtonPress-1>", lambda e: self._down_changed(True))
        self.bind("<ButtonRelease-1>",
                  lambda e: (self._down_changed(False), self.fire()))
        self.bind("<Configure>", lambda e: self.draw())
        self.bind("<Return>", lambda e: self.fire())
        self.bind("<space>", lambda e: self.fire())
        self.draw()

    def _app(self):
        w = self.master
        while w is not None and not isinstance(w, App):
            w = getattr(w, "master", None)
        return w

    def _locked(self):
        app = self._app()
        return app is not None and (app.worker.busy or app.ui_locked)

    def _hover_changed(self, on):
        if self._hover != on:
            self._hover = on
            self.draw()

    def _down_changed(self, on):
        if self._down != on:
            self._down = on
            self.draw()

    def fire(self):
        if self.command and not self._locked():
            self.command()

    def draw(self):
        self.delete("all")
        w, h = self.winfo_width(), self.winfo_height()
        if w < 10 or h < 10:
            return
        r = min(9, h // 2)
        if self.accent:
            base = "#25a25a" if self._down else ("#3ddc84" if self._hover else ACCENT)
            fg = "white"
        else:
            base = "#171c25" if self._down else (HOVER if self._hover else PANEL)
            fg = FG
        _rounded(self, 1, 1, w - 1, h - 1, r, base)
        self.create_text(w / 2, h / 2, text=self.text, fill=fg,
                         font=(FONT, 10, "bold"))

class Pill(tk.Canvas):
    """Compact status pill: tinted pill + glyph + short label."""
    def __init__(self, parent, kind, text):
        self.kind, self.text = kind, text
        self._font = tkfont.Font(font=(FONT, 9, "bold"))
        w = self._font.measure(text) + 44
        super().__init__(parent, width=w, height=24,
                         highlightthickness=0, bg=parent["bg"])
        self.draw()

    def draw(self):
        self.delete("all")
        w, h = self.winfo_width(), self.winfo_height()
        if w < 10:
            return
        r = h // 2
        base = PILL_BG[self.kind]
        _rounded(self, 0, 0, w, h, r, base)
        self.create_text(13, h / 2, text=PILL_GLYPH[self.kind],
                         fill=PILL_FG[self.kind], font=(FONT, 10, "bold"),
                         anchor="w")
        self.create_text(26, h / 2, text=self.text,
                         fill=PILL_FG[self.kind], font=self._font, anchor="w")

class Card(tk.Frame):
    """Bordered card container."""
    def __init__(self, parent):
        super().__init__(parent, bg=CARD, highlightthickness=1,
                         highlightbackground=BORDER)

class NavButton(tk.Canvas):
    """Sidebar item: glyph + label, accent bar when active."""
    def __init__(self, parent, glyph, label, command, app):
        self.app, self.command, self.glyph, self.label = app, command, glyph, label
        self.active = False
        self._hover = False
        super().__init__(parent, height=42, highlightthickness=0,
                         bg=PANEL, takefocus=True)
        self.bind("<Enter>", lambda e: self._hover_changed(True))
        self.bind("<Leave>", lambda e: self._hover_changed(False))
        self.bind("<ButtonRelease-1>", lambda e: self.fire())
        self.bind("<Configure>", lambda e: self.draw())
        self.bind("<Return>", lambda e: self.fire())
        self.bind("<space>", lambda e: self.fire())
        self.draw()

    def _hover_changed(self, on):
        if self._hover != on:
            self._hover = on
            self.draw()

    def fire(self):
        if self.command and not (self.app.worker.busy or self.app.ui_locked):
            self.command()

    def draw(self):
        self.delete("all")
        w, h = self.winfo_width(), self.winfo_height()
        if w < 10:
            return
        if self.active:
            self.create_rectangle(0, 0, 4, h, fill=ACCENT, outline="")
            base = "#22303f"
            fg, glyph_fg = FG, ACCENT
        elif self._hover:
            base = HOVER
            fg, glyph_fg = FG, DIM
        else:
            base = PANEL
            fg, glyph_fg = DIM, DIM
        self.create_rectangle(0, 0, w, h, fill=base, outline="")
        self.create_text(16, h / 2, text=self.glyph, fill=glyph_fg,
                         font=(FONT, 12), anchor="w")
        self.create_text(44, h / 2, text=self.label, fill=fg,
                         font=(FONT, 10, "bold" if self.active else "normal"),
                         anchor="w")

class ScrollFrame(tk.Frame):
    """Scrollable page container (works on small windows too)."""
    def __init__(self, parent, bg=BG):
        super().__init__(parent, bg=bg)
        self.vbar = tk.Scrollbar(self, orient="vertical",
                                 bg=PANEL, troughcolor=BG,
                                 highlightthickness=0)
        self.canvas = tk.Canvas(self, bg=bg, highlightthickness=0,
                                yscrollcommand=self.vbar.set)
        self.vbar.config(command=self.canvas.yview)
        self.vbar.pack(side="right", fill="y")
        self.canvas.pack(side="left", fill="both", expand=True)
        self.inner = tk.Frame(self.canvas, bg=bg)
        self.win = self.canvas.create_window((0, 0), window=self.inner,
                                             anchor="nw")
        self.inner.bind("<Configure>", self._on_resize)
        self.canvas.bind("<Configure>", self._on_width)
        self.canvas.bind("<MouseWheel>", self._wheel)
        self.inner.bind("<MouseWheel>", self._wheel)
        self.canvas.bind("<Button-4>", self._wheel)
        self.canvas.bind("<Button-5>", self._wheel)
        self.inner.bind("<Button-4>", self._wheel)
        self.inner.bind("<Button-5>", self._wheel)

    def _on_resize(self, e):
        self.canvas.configure(scrollregion=self.canvas.bbox("all"))
        self.canvas.itemconfig(self.win, width=e.width)

    def _on_width(self, e):
        self.canvas.itemconfig(self.win, width=e.width)

    def _wheel(self, e):
        d = 0
        if e.num == 4:
            d = -1
        elif e.num == 5:
            d = 1
        elif hasattr(e, "delta"):
            d = -int(e.delta / 120)
        if d:
            self.canvas.yview_scroll(d, "units")
            return "break"

class Toast(tk.Toplevel):
    """Slide-in notification at the bottom-right; auto-dismisses."""
    LIFE = 2800

    def __init__(self, app, kind, text):
        super().__init__(app)
        self.app = app
        self.kind = kind
        self.overrideredirect(True)
        self.configure(bg=CARD)
        self.attributes("-topmost", True)
        box = tk.Frame(self, bg=CARD, highlightthickness=1,
                       highlightbackground=BORDER)
        box.pack(fill="both", expand=True, padx=1, pady=1)
        row = tk.Frame(box, bg=CARD)
        row.pack(fill="x", padx=14, pady=10)
        tk.Label(row, text=PILL_GLYPH.get(kind, "i"),
                 bg=CARD, fg=PILL_FG.get(kind, BLUE),
                 font=(FONT, 12, "bold")).pack(side="left")
        tk.Label(row, text="  " + text, bg=CARD, fg=FG,
                 font=(FONT, 10), wraplength=380,
                 justify="left").pack(side="left", anchor="w")
        box.bind("<ButtonRelease-1>", lambda e: self.gone())
        row.bind("<ButtonRelease-1>", lambda e: self.gone())
        self.update_idletasks()
        # position bottom-right of the main window
        ax, ay = app.winfo_rootx(), app.winfo_rooty()
        aw = app.winfo_width()
        tw, th = self.winfo_width(), self.winfo_height()
        x = ax + aw - tw - 24
        y = ay + app.winfo_height() - th - 24
        self._x, self._y = max(0, x), max(0, y)
        self.geometry(f"+{self._x}+{self._y + 40}")
        self._slide()

    def _slide(self):
        cy = int(self.geometry().split("+")[-1])
        if cy > self._y:
            self.geometry(f"+{self._x}+{max(self._y, cy - 6)}")
            self.after(12, self._slide)
        else:
            self.after(self.LIFE, self.gone)

    def gone(self):
        try:
            self.destroy()
        except tk.TclError:
            pass

# ---------- dialogs ----------
class Dialog(tk.Toplevel):
    def __init__(self, app, title, width=560, height=420):
        super().__init__(app)
        self.app = app
        self.result = None
        self.title(title)
        self.configure(bg=BG)
        self.transient(app)
        self.grab_set()
        self.geometry(f"{width}x{height}+{app.winfo_x()+40}+{app.winfo_y()+40}")
        self.bind("<Escape>", lambda e: self.cancel())
        try:
            self.iconphoto(True, tk.PhotoImage(data=LOGO_B64, format="png"))
        except Exception:
            pass

    def cancel(self):
        self.result = False
        self.destroy()

    def finish(self, val=True):
        self.result = val
        self.destroy()

class Confirm(Dialog):
    """'Are you sure?' with explanation. Defaults to No."""
    def __init__(self, app, title, lines, yes="Yes, do it", no="Cancel"):
        super().__init__(app, title, 540, 130 + 26 * len(lines))
        fr = tk.Frame(self, bg=BG); fr.pack(fill="both", expand=True, padx=16, pady=14)
        tk.Label(fr, text="⚠ " + title, bg=BG, fg=YELLOW,
                 font=(FONT, 12, "bold")).pack(anchor="w")
        for ln in lines:
            tk.Label(fr, text=ln, bg=BG, fg=FG, justify="left",
                     wraplength=480, font=(FONT, 10)).pack(anchor="w", pady=2)
        row = tk.Frame(fr, bg=BG); row.pack(pady=(16, 0), anchor="e")
        RButton(row, no, command=self.cancel, width=130, bg=BG).pack(side="right", padx=(8, 0))
        RButton(row, yes, command=lambda: self.finish(True), width=150,
                accent=True, bg=BG).pack(side="right")

class Chooser(Dialog):
    """List picker with ↑/↓ + Enter, Esc cancels, • markers."""
    def __init__(self, app, title, items, marker_idx=None):
        super().__init__(app, title, 640, 460)
        self.items = items
        self.sel = marker_idx if marker_idx is not None else 0
        tk.Label(self, text=title, bg=BG, fg=FG,
                 font=(FONT, 12, "bold")).pack(anchor="w", padx=14, pady=(12, 4))
        self.lb = tk.Listbox(self, bg=PANEL, fg=FG, selectbackground="#2f4a63",
                             selectforeground="white", font=(MONO, 11),
                             highlightthickness=1, highlightbackground=BORDER,
                             activestyle="none", exportselection=False,
                             borderwidth=0)
        for i, (label, _) in enumerate(items):
            self.lb.insert("end", label)
        self.lb.pack(fill="both", expand=True, padx=12, pady=(4, 4))
        self.lb.select_set(self.sel)
        self.lb.see(self.sel)
        tk.Label(self, text="↑/↓ move   Enter select   Esc cancel",
                 bg=BG, fg=DIM, font=(FONT, 9)).pack(pady=(0, 10))
        self.lb.bind("<Return>", lambda e: self._pick())
        self.lb.bind("<Double-Button-1>", lambda e: self._pick())
        self.lb.focus_set()
        self.after(50, self._loop)

    def _loop(self):
        cur = self.lb.curselection()
        if cur and cur[0] != self.sel:
            self.sel = cur[0]
        self.after(80, self._loop)

    def _pick(self):
        self.finish(self.items[self.sel][1])

class Preview(tk.Toplevel):
    """Plays a theme's animation inside the app. ESC or Close stops it."""
    def __init__(self, app, title, path):
        super().__init__(app)
        self.app = app
        self._path = path
        self.title(title)
        self.configure(bg=BG)
        self.transient(app)
        self.frames = None
        self.img = None
        self._after_id = None
        self._closed = False
        try:
            self.iconphoto(True, tk.PhotoImage(data=LOGO_B64, format="png"))
        except Exception:
            pass
        top = tk.Frame(self, bg=BG); top.pack(fill="x", padx=12, pady=(10, 4))
        tk.Label(top, text="◐ " + title, bg=BG, fg=FG,
                 font=(FONT, 11, "bold")).pack(side="left")
        RButton(top, "Close", command=self.close, width=100, bg=BG).pack(side="right")
        self.view = tk.Label(self, bg="#0c0e12")
        self.view.pack(padx=12, pady=(4, 10))
        self.bind("<Escape>", lambda e: self.close())
        self.protocol("WM_DELETE_WINDOW", self.close)
        self.frames = gif_frames(path)
        self._step()

    def close(self):
        self._closed = True
        if self._after_id is not None:
            self.after_cancel(self._after_id)
            self._after_id = None
        self.destroy()

    def _step(self):
        if self._closed or self.frames is None:
            return
        try:
            ppm, delay = next(self.frames)
        except StopIteration:
            self._after_id = self.after(50, self._restart)
            return
        except Exception:
            self.close()
            return
        try:
            self.img = tk.PhotoImage(data=ppm, format="ppm")
            self.view.config(image=self.img)
        except Exception:
            self.close()
            return
        self._after_id = self.after(delay, self._step)

    def _restart(self):
        if self._closed:
            return
        try:
            self.frames = gif_frames(self._path)
        except Exception:
            self.close()
            return
        self._step()

