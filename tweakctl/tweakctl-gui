    def _draw_busy(self, step):
        self.busy_canvas.delete("all")
        busy = self.worker.busy
        cols = ["#3a4356", "#566178", "#7b8699", "#566178"] if busy else ["#3a4356"]
        col = cols[step % len(cols)]
        self.busy_canvas.create_oval(1, 1, 13, 13, fill=col, outline="")
        if busy:
            self._busy_after = self.after(140, lambda: self._draw_busy(step + 1))
        else:
            self._busy_after = None

    def set_busy(self, on):
        if on:
            if self._busy_after is None:
                self._draw_busy(0)
        else:
            if self._busy_after is not None:
                self.after_cancel(self._busy_after)
                self._busy_after = None
            self._draw_busy(0)

    def set_buttons_state(self, st):
        self.ui_locked = (st != "normal")

    def show(self, key):
        for k, b in self.navbtns.items():
            b.active = (k == key)
            b.draw()
        for w in self.content.inner.winfo_children():
            w.destroy()
        self.content.canvas.yview_moveto(0)
        page_fn = getattr(self, f"page_{key}")
        page_fn(self.content.inner)
        self.current = key

    def toast(self, kind, text):
        """Thread-safe toast: always created on the main thread."""
        self.after(0, lambda: Toast(self, kind, text))

    def log(self, text):
        self.logbox.config(state="normal")
        for line in strip(text).splitlines() or [""]:
            tag = "info"
            if "[OK]" in line or ">>>" in line: tag = "ok"
            elif "[FAIL]" in line or "NOT" in line: tag = "fail"
            elif "[WARN]" in line: tag = "warn"
            self.logbox.insert("end", line + "\n", tag)
        self.logbox.see("end")
        self.logbox.config(state="disabled")

