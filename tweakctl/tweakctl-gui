    # ----- actions -----
    def refresh(self):
        self.show(getattr(self, "current", "dash"))

    def act_hib(self, force=False):
        def go():
            if not force and TC.hibernation_ready():
                self.q_confirm([
                    "Hibernation is already implemented on this machine.",
                    "Re-applying will rewrite GRUB / initramfs / fstab again.",
                    "Only continue if you know what you are doing."])
                return
            self.log(">> Setting up hibernation (needs root)...")
            rc, out = run_cli(["hibernate", "enable"])
            self.log(out)
            if rc == 0:
                self.log("[OK] Done — reboot, then test with: systemctl hibernate")
                self.toast("ok", "Hibernation set up — reboot, then run systemctl hibernate")
        self.worker.start(go)

    def q_confirm(self, lines):
        """Confirm from the worker thread; blocks it until answered."""
        box = {}
        def ask():
            d = Confirm(self, "Are you sure?", lines)
            self.wait_window(d)
            box["r"] = d.result
        self.after(0, ask)
        while "r" not in box:
            time.sleep(0.05)
        if box["r"] is not True:
            self.log("[INFO] Cancelled — nothing was changed.")

    def act_s3(self, mode):
        def go():
            _, active, _ = TC.s3_state()
            if mode == "deep" and active:
                self.q_confirm(["S3 deep sleep is already the active mode.",
                                "Re-applying will rewrite the kernel cmdline again."])
                return
            self.log(f">> Setting suspend mode to {mode} (needs root)...")
            rc, out = run_cli(["s3", "set-deep" if mode == "deep" else "set-s2idle"])
            self.log(out)
            if rc == 0:
                self.toast("ok", f"Suspend mode set to {mode} — reboot to apply")
        self.worker.start(go)

    def act_apply(self, theme):
        def go():
            self.log(f">> Setting boot splash theme to '{theme}' (needs root)...")
            rc, out = run_cli(["plymouth", "apply", "--theme", theme])
            self.log(out)
            if rc == 0:
                self.toast("ok", f"Boot splash theme set to '{theme}' — reboot to see it")
        self.worker.start(go)

    def act_preview(self, theme):
        """Preview a Plymouth theme: play its animation inside the app.
        Falls back to the live boot splash when no animation is available."""
        theme = theme or TC.current_plymouth_theme() or "default"
        self.log(f">> Loading animation for '{theme}'...")
        try:
            gif = TC.theme_animation_gif(theme)
        except Exception as e:
            gif = None
            self.log(f"[WARN] could not build animation: {e}")
        if gif:
            self.log(f"[OK] Playing the '{theme}' animation in the app.")
            Preview(self, f"Boot splash preview — {theme}", gif)
            return
        # no animation available: try the live boot splash (console sessions)
        self.log(f">> No animation for '{theme}' — trying the live boot splash (needs root)...")
        def go():
            rc, out = run_cli(["plymouth", "preview", "--theme", theme], timeout=60)
            self.log(out)
        self.worker.start(go)

    def stop_preview(self):
        """Stop the running Plymouth preview (called from ESC or Close button)."""
        if hasattr(self, "_preview_stop"):
            self._preview_stop.set()
        if self.worker.preview_proc:
            try:
                self.worker.preview_proc.terminate()
                self.worker.preview_proc.wait(timeout=5)
            except Exception:
                try:
                    self.worker.preview_proc.kill()
                except Exception:
                    pass
            self.worker.preview_proc = None
        self.log("[INFO] Preview stopped.")

    def preview(self, path):
        def go():
            self.log(f">> Playing {os.path.basename(path)}...")
            rc, out = run_cli(["sound", "preview", "--name", path], elevated=False, timeout=60)
            self.log(out)
        self.worker.start(go)

    def stop_sound(self):
        if self.playing:
            self.playing.terminate()
            self.playing = None
            self.log("[INFO] Playback stopped.")

    def act_sound(self, path):
        def go():
            self.log(f">> Setting startup sound to {os.path.basename(path)}...")
            rc, out = run_cli(["sound", "apply", "--name", path], elevated=False)
            self.log(out)
            if rc == 0:
                self.toast("ok", f"Startup sound set to {os.path.basename(path)}")
        self.worker.start(go)

    def act_update(self):
        def go():
            self.log(">> Checking for updates...")
            rc, out = run_cli(["update-check"], elevated=False, timeout=30)
            self.log(out)
            if hasattr(self, "_upd_result"):
                self.after(0, lambda: self._upd_result.config(text=strip(out)))
        self.worker.start(go)

    def act_disclaimer(self):
        d = Disclaimer(self)
        self.wait_window(d)
        if d.result is True:
            TC.save_disclaimer()
            self.log("Disclaimer accepted — saved.")

    def on_close(self):
        self.stop_preview()
        if self.playing:
            self.playing.terminate()
        self.destroy()

    # ----- self test -----
    def selftest(self):
        checks = []
        def ck(name, cond):
            checks.append((name, bool(cond)))
            print(("PASS " if cond else "FAIL ") + name)
        try:
            ck("disclaimer accepted", TC.disclaimer_accepted())
            ready, items = TC.hibernation_state()
            ck("hibernation_state returns items", isinstance(items, list) and len(items) > 3)
            ck("s3_state returns 3-tuple", len(TC.s3_state()) == 3)
            ck("sound_choices returns list", isinstance(TC.sound_choices(), list))
            ck("current_plymouth_theme", isinstance(TC.current_plymouth_theme(), (str, type(None))))
            ck("windows_present", TC.windows_present() in (True, False))
            # logo loads from the embedded base64
            ck("embedded logo loads", self.logo_img.width() == 32)
            # navigation
            for key in ["dash", "hib", "s3", "ply", "snd", "upd", "abt"]:
                self.show(key)
                self.update()
                ck(f"page {key} renders", len(self.content.inner.winfo_children()) > 0)
            # widgets render
            w = tk.Frame(self.content.inner, bg=BG)
            w.pack()
            rb = RButton(w, "test", command=None, bg=BG)
            rb.pack()
            self.update()
            ck("RButton renders", rb.winfo_width() > 0)
            pl = Pill(w, "ok", "TEST")
            pl.pack()
            self.update()
            ck("Pill renders", pl.winfo_width() > 0)
            # chooser dialog
            self.show("snd")
            c = Chooser(self, "t", [("a", "x"), ("b  • current", "y")], 1)
            self.update()
            ck("chooser lists items", c.lb.size() == 2)
            c._pick()
            ck("chooser picks", c.result == "y")
            # confirm dialog defaults to No
            cf = Confirm(self, "t", ["line1", "line2"])
            self.update()
            cf.cancel()
            ck("confirm cancel", cf.result is False)
            # disclaimer dialog builds
            d = Disclaimer(self)
            self.update()
            ck("disclaimer builds", d.result is None)
            d.cancel()
            # toast shows and dismisses
            t = Toast(self, "ok", "selftest toast")
            self.update()
            ck("toast shows", t.winfo_exists())
            t.gone()
            # log with ANSI strip
            self.log("\x1b[92m[OK]\x1b[0m green line")
            self.update()
            flat = self.logbox.get("1.0", "end")
            ck("ansi stripped", "\x1b" not in flat and "[OK]" in flat)
            # cli path resolution
            ck("cli path found", os.path.exists(TWEAKCTL_PATH))
            # GIF decoder: decode the first frames of the cached preview
            import glob as _glob
            gifs = _glob.glob(os.path.expanduser("~/.cache/tweakctl/*-preview.gif"))
            if gifs:
                it = gif_frames(gifs[0])
                ppm, delay = next(it)
                ck("gif decodes frame 1", ppm.startswith(b"P6\n") and delay >= 20)
                ppm2, _ = next(it)
                ck("gif decodes frame 2", ppm2.startswith(b"P6\n"))
            else:
                try:
                    list(gif_frames("/etc/hostname"))
                    ck("gif rejects non-gif", False)
                except (ValueError, OSError):
                    ck("gif rejects non-gif", True)
            # theme animation source (uses ffmpeg/bundled gif)
            try:
                g = TC.theme_animation_gif("watch-dogs")
                ck("theme_animation_gif", g is None or os.path.exists(g))
            except Exception:
                ck("theme_animation_gif", False)
        except Exception as e:
            import traceback; traceback.print_exc()
            ck(f"exception: {e}", False)
        ok = all(c for _, c in checks)
        print(f"\n{sum(c for _, c in checks)}/{len(checks)} checks passed")
        self.destroy()
        sys.exit(0 if ok else 1)

def main():
    p = argparse.ArgumentParser(prog="tweakctl-gui",
        description="Graphical front-end for tweakctl — hibernation, S3, Plymouth, sounds.")
    p.add_argument("--version", action="version", version=VERSION)
    p.add_argument("--selftest", action="store_true",
                   help="run headless self-test and exit")
    a = p.parse_args()
    App(selftest=a.selftest).mainloop()

if __name__ == "__main__":
    main()
